# Copy to .env (git-ignored) and replace every value. Never commit real secrets.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
# At least 32 random characters, e.g. generated with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Production only (docker-compose.prod.yml): public host names pointing to the server.
WEB_DOMAIN=erp.example.com
API_DOMAIN=api.example.com
