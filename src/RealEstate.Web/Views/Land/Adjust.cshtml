@model AdjustLandViewModel
@using RealEstate.Domain.Enums
@{ ViewData["Title"] = "Adjust project area"; }
<partial name="_LandNav" model='(Model.ProjectId, Model.ProjectName, "Adjust")' />
<div class="card"><div class="card-body">
<p class="text-muted">Current project area: <strong>@Model.CurrentArea.ToString("N4") @Model.Unit</strong>. Area never changes without an approved adjustment record.</p>
<form asp-action="Adjust" method="post" enctype="multipart/form-data" data-loading-form>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="ProjectId" /><input type="hidden" asp-for="RowVersion" />
    <div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="AdjustmentDate" class="form-label"></label><input asp-for="AdjustmentDate" type="date" class="form-control" /><span asp-validation-for="AdjustmentDate" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<LandAdjustmentType>()" class="form-select"></select></div>
        <div class="col-12 col-lg-4"><label asp-for="Area" class="form-label">Area (@Model.Unit)</label><input asp-for="Area" type="number" step="0.0001" min="0.0001" class="form-control" /><span asp-validation-for="Area" class="text-danger small"></span></div>
        <div class="col-12"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" rows="2" class="form-control"></textarea><span asp-validation-for="Reason" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="SupportingReference" class="form-label"></label><input asp-for="SupportingReference" class="form-control" /><span asp-validation-for="SupportingReference" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="Document" class="form-label">Attach supporting file (optional)</label><input asp-for="Document" type="file" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="ApprovedByUserId" class="form-label"></label>
            <select asp-for="ApprovedByUserId" class="form-select"><option value="">- Select approver -</option>@foreach (var a in Model.Approvers) { <option value="@a.Id" selected="@(Model.ApprovedByUserId == a.Id)">@a.FullName</option> }</select>
            <span asp-validation-for="ApprovedByUserId" class="text-danger small"></span></div>
    </div>
    @if (Model.Approvers.Count == 0) { <div class="alert alert-warning mt-3 mb-0">No active user holds the "Approve land adjustments" permission, so adjustments cannot be recorded yet.</div> }
    <div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-primary" disabled="@(Model.Approvers.Count == 0)"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Record adjustment</button><a class="btn btn-outline-secondary" asp-action="Index" asp-route-projectId="@Model.ProjectId">Cancel</a></div>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
