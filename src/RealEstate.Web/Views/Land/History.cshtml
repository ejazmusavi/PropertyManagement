@model AreaHistoryViewModel
@using RealEstate.Domain.Enums
@{ ViewData["Title"] = "Area adjustment history"; var o = Model.Overview; var h = Model.History; var d = Model.DistributionHistory;
   var hRoute = new Dictionary<string, string?> { ["dpage"] = d.Page.ToString() }; var dRoute = new Dictionary<string, string?> { ["page"] = h.Page.ToString() }; }
<partial name="_LandNav" model='(o.ProjectId, o.ProjectName, "History")' />
<div class="card mb-3"><div class="card-header fw-semibold">Project area history</div>
@if (h.Items.Count == 0) { <div class="card-body text-muted">No history yet.</div> }
else
{
    <div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>Effective</th><th>Source</th><th class="text-end">Previous</th><th class="text-end">Change</th><th class="text-end">New</th><th>Reason / support</th><th>Recorded</th></tr></thead><tbody>
    @foreach (var x in h.Items)
    {
        <tr><td data-label="Effective">@x.EffectiveDate.ToString("yyyy-MM-dd")</td><td data-label="Source">@x.Source</td><td data-label="Previous" class="text-end">@x.PreviousArea.ToString("N4")</td>
            <td data-label="Change" class="text-end">@x.Change.ToString("+0.####;-0.####;0")</td><td data-label="New" class="text-end">@x.NewArea.ToString("N4")</td>
            <td data-label="Reason">@x.Reason@if (x.SupportingReference is not null) { <div class="small text-muted">Support: @x.SupportingReference &middot; approved by @x.ApprovedBy</div> }</td>
            <td data-label="Recorded">@x.ChangedAtUtc.ToString("yyyy-MM-dd HH:mm")<div class="small text-muted">@x.ChangedBy</div></td></tr>
    }
    </tbody></table></div>
}
</div>
<partial name="_Pager" model='(h.Page, h.TotalPages, h.TotalCount, "area records", hRoute, "page")' />
<div class="card mt-3"><div class="card-header fw-semibold">Distribution history</div>
@if (d.Items.Count == 0) { <div class="card-body text-muted">No distribution changes recorded.</div> }
else
{
    <div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>Category</th><th class="text-end">Previous</th><th class="text-end">New</th><th>Reason</th><th>Changed</th></tr></thead><tbody>
    @foreach (var x in d.Items) { <tr><td data-label="Category">@x.Category</td><td data-label="Previous" class="text-end">@x.PreviousArea.ToString("N4")</td><td data-label="New" class="text-end">@x.NewArea.ToString("N4")</td><td data-label="Reason">@x.Reason</td><td data-label="Changed">@x.ChangedAtUtc.ToString("yyyy-MM-dd HH:mm") <span class="small text-muted">@x.ChangedBy</span></td></tr> }
    </tbody></table></div>
}
</div>
<partial name="_Pager" model='(d.Page, d.TotalPages, d.TotalCount, "distribution records", dRoute, "dpage")' />
