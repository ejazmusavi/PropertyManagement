@model TemplateFormViewModel
@{ ViewData["Title"] = "Edit template"; }
<h1 class="h3 mb-1">Edit template</h1>
<div class="text-muted mb-3">@Model.Type &middot; @Model.Channel &middot; @Model.Language</div>
<form asp-action="TemplateForm" method="post" data-loading-form>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="Type" /><input type="hidden" asp-for="Channel" /><input type="hidden" asp-for="Language" /><input type="hidden" asp-for="RowVersion" />
    <div class="card mb-3"><div class="card-body"><div class="row g-3">
        <div class="col-12"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" maxlength="200" /><span asp-validation-for="Subject" class="text-danger small"></span></div>
        <div class="col-12"><label asp-for="Body" class="form-label"></label><textarea asp-for="Body" class="form-control" rows="5" maxlength="2000"></textarea><span asp-validation-for="Body" class="text-danger small"></span>
            <div class="form-text">Placeholders: @string.Join(", ", RealEstate.Domain.Entities.NotificationRules.Placeholders.Select(p => "{{" + p + "}}"))</div></div>
        <div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
    </div></div></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Save</button><a class="btn btn-outline-secondary" asp-action="Templates">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
