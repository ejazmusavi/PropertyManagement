@model ProjectAccessViewModel
@{ ViewData["Title"] = "Project access"; var p = Model.Project; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Project access &ndash; @p.ProjectName</h1>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@p.Id">Back to project</a>
</div>
<p class="text-muted">Users see only the projects they are assigned to (unless their role grants access to all projects).</p>
<div class="card mb-3"><div class="card-header fw-semibold">Users with access</div>
@if (Model.Assigned.Count == 0) { <div class="card-body text-muted">No users are assigned.</div> }
else
{
    <div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>Name</th><th>Email</th><th>Since</th><th></th></tr></thead><tbody>
    @foreach (var u in Model.Assigned)
    {
        <tr><td data-label="Name">@u.FullName @if (u.IsProjectManager) { <span class="badge text-bg-primary">Manager</span> }</td><td data-label="Email">@u.Email</td><td data-label="Since">@u.AssignedAtUtc.ToString("yyyy-MM-dd")</td>
        <td class="text-end">@if (!u.IsProjectManager) { <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#revokeModal" data-user-id="@u.UserId" data-user-name="@u.FullName">Revoke</button> }</td></tr>
    }
    </tbody></table></div>
}
</div>
<div class="card"><div class="card-header fw-semibold">Grant access</div><div class="card-body">
@if (Model.Candidates.Count == 0) { <span class="text-muted">All active users already have access.</span> }
else
{
    <form asp-action="AssignAccess" asp-route-id="@p.Id" method="post" class="row g-2 align-items-end">
        <div class="col-12 col-lg-6"><label class="form-label">User</label><select name="userId" class="form-select" required>@foreach (var u in Model.Candidates) { <option value="@u.Id">@u.FullName (@u.Email)</option> }</select></div>
        <div class="col-12 col-lg-2"><button class="btn btn-primary w-100" type="submit">Grant access</button></div>
    </form>
}
</div></div>
<div class="modal fade" id="revokeModal" tabindex="-1" aria-labelledby="revokeTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" asp-action="RevokeAccess" asp-route-id="@p.Id" method="post"><input type="hidden" name="userId" id="revokeUserId" />
        <div class="modal-header"><h2 class="modal-title fs-5" id="revokeTitle">Revoke access</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"><p>Revoke <strong id="revokeUserName"></strong>'s access to this project?</p><label class="form-label">Reason (required)</label><input name="reason" class="form-control" required maxlength="500" /></div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Revoke</button></div>
    </form></div></div>
@section Scripts {
<script>
document.getElementById('revokeModal')?.addEventListener('show.bs.modal', function (e) {
  document.getElementById('revokeUserId').value = e.relatedTarget.dataset.userId;
  document.getElementById('revokeUserName').textContent = e.relatedTarget.dataset.userName;
});
</script>
}
