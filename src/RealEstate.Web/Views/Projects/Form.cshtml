@model ProjectFormViewModel
@using RealEstate.Domain.Enums
@{ var editing = Model.Id.HasValue; ViewData["Title"] = editing ? "Edit project" : "New project"; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-loading-form>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="RowVersion" />
    <div class="card mb-3"><div class="card-header fw-semibold">Project</div><div class="card-body"><div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="ProjectCode" class="form-label"></label><input asp-for="ProjectCode" class="form-control" readonly="@editing" /><span asp-validation-for="ProjectCode" class="text-danger small"></span></div>
        <div class="col-12 col-lg-8"><label asp-for="ProjectName" class="form-label"></label><input asp-for="ProjectName" class="form-control" /><span asp-validation-for="ProjectName" class="text-danger small"></span></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
        <div class="col-12 col-lg-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger small"></span></div>
        <div class="col-12 col-lg-8"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="ExpectedCompletionDate" class="form-label"></label><input asp-for="ExpectedCompletionDate" type="date" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="ProjectManagerId" class="form-label"></label>
            <select asp-for="ProjectManagerId" class="form-select"><option value="">- None -</option>@foreach (var u in Model.Managers) { <option value="@u.Id" selected="@(Model.ProjectManagerId == u.Id)">@u.FullName (@u.Email)</option> }</select></div>
        <div class="col-12 col-lg-4"><label asp-for="InitialArea" class="form-label"></label><input asp-for="InitialArea" type="number" step="0.0001" min="0" class="form-control" readonly="@editing" /><span asp-validation-for="InitialArea" class="text-danger small"></span>
            @if (editing) { <div class="form-text">Area changes only through land acquisitions and adjustments.</div> }</div>
        <div class="col-12 col-lg-4"><label asp-for="MeasurementUnit" class="form-label"></label>
            @if (editing) { <input class="form-control" value="@Model.MeasurementUnit" readonly /><input type="hidden" asp-for="MeasurementUnit" /> }
            else { <select asp-for="MeasurementUnit" asp-items="Html.GetEnumSelectList<MeasurementUnit>()" class="form-select"></select> }</div>
    </div></div></div>
    <div class="card mb-3"><div class="card-header fw-semibold">Location details</div><div class="card-body"><div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="AddressLine" class="form-label"></label><input asp-for="AddressLine" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="Locality" class="form-label"></label><input asp-for="Locality" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="Province" class="form-label"></label><input asp-for="Province" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="PostalCode" class="form-label"></label><input asp-for="PostalCode" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="Landmark" class="form-label"></label><input asp-for="Landmark" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" type="number" step="0.000001" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" type="number" step="0.000001" class="form-control" /></div>
    </div></div></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Save project</button>
        <a class="btn btn-outline-secondary" href="@(editing ? Url.Action("Details", new { id = Model.Id }) : Url.Action("Index"))">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
