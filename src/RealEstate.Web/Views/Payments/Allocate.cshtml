@model AllocationFormViewModel
@using RealEstate.Domain.Enums
@{ var p = Model.Payment!; var o = Model.Options!; var s = o.CurrencySymbol; ViewData["Title"] = "Allocate payment " + p.PaymentNumber; }
<h1 class="h3 mb-1">Allocate payment @p.PaymentNumber</h1>
<p class="text-muted">Agreement @p.AgreementNumber &middot; @p.CustomerName &middot; receipt @(p.Receipt?.ReceiptNumber ?? "-")</p>
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Unallocated</div><div class="fs-5 fw-semibold">@s @o.Unallocated.ToString("N2")</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Held as advance</div><div class="fs-5 fw-semibold">@s @o.AdvanceHeld.ToString("N2")</div></div></div></div>
</div>
@if (p.Status != PaymentStatus.Posted || (o.Unallocated == 0 && o.AdvanceHeld == 0))
{
    <div class="alert alert-info">Nothing to allocate: only posted payments with an unallocated or advance balance can be allocated.</div>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@p.Id">Back</a>
}
else
{
    <form asp-action="Allocate" asp-route-id="@p.Id" method="post" data-loading-form>
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="RowVersion" />
        @if (o.AdvanceHeld > 0)
        {
            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="includeAdvance" name="IncludeAdvance" value="true" checked="@Model.IncludeAdvance" /><input type="hidden" name="IncludeAdvance" value="false" />
                <label class="form-check-label" for="includeAdvance">Also re-apply the @s @o.AdvanceHeld.ToString("N2") held as advance</label></div>
        }
        <partial name="_AllocationEditor" model='new AllocationEditorModel("Mode", Model.Mode, Model.ChargeId, Model.RemainderToAdvance, o.Lines, o.Charges, Model.Lines, s, false)' />
        <p class="text-muted small">An allocation can never exceed the money available on this payment or a line's outstanding balance.</p>
        <div class="d-flex flex-wrap gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Save allocation</button>
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@p.Id">Cancel</a></div>
    </form>
}
@section Scripts { <script src="~/js/payments.js" asp-append-version="true"></script> }
