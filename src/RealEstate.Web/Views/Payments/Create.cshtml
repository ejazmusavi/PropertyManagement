@model PaymentFormViewModel
@using RealEstate.Domain.Enums
@{ var c = Model.Context!; var s = c.CurrencySymbol; ViewData["Title"] = "Collect payment"; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div><h1 class="h3 mb-1">Collect payment</h1><div class="text-muted">Agreement @c.AgreementNumber &middot; booking @c.BookingNumber &middot; @c.ProjectCode</div></div>
    <div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-secondary" asp-controller="Ledgers" asp-action="Agreement" asp-route-id="@c.AgreementId">Agreement ledger</a><a class="btn btn-outline-secondary" asp-action="Create">Other agreement</a></div>
</div>
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Due to date (unpaid)</div><div class="fs-5 fw-semibold">@s @c.OutstandingDue.ToString("N2")</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Overdue</div><div class="fs-5 fw-semibold @(c.Overdue > 0 ? "text-danger" : "")">@s @c.Overdue.ToString("N2")</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Scheduled, not yet due</div><div class="fs-5 fw-semibold">@s @c.NotYetDue.ToString("N2")</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Customer credit</div><div class="fs-5 fw-semibold">@s @c.CreditBalance.ToString("N2")</div></div></div></div>
</div>
@if (!c.HasSchedule) { <div class="alert alert-warning">This agreement has no payment schedule yet. The payment can be recorded and held as advance or unallocated until the schedule is generated.</div> }
<form asp-action="Create" method="post" data-loading-form>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="AgreementId" /><input type="hidden" asp-for="IdempotencyKey" />
    <div class="card mb-3"><div class="card-header fw-semibold">Payment</div><div class="card-body"><div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="CustomerId" class="form-label">Paid by (party)</label>
            <select asp-for="CustomerId" class="form-select">@foreach (var p in c.Parties) { <option value="@p.CustomerId" selected="@(Model.CustomerId == p.CustomerId)">@p.FullName (@p.CustomerCode)@(p.IsPrimary ? " - account holder" : "")</option> }</select></div>
        <div class="col-12 col-lg-4"><label asp-for="PaymentMethodId" class="form-label"></label>
            <select asp-for="PaymentMethodId" class="form-select" data-payment-method>@foreach (var m in Model.Methods) { <option value="@m.Id" data-kind="@m.Kind" data-ref="@m.RequiresReference.ToString().ToLowerInvariant()" selected="@(Model.PaymentMethodId == m.Id)">@m.Name@(m.RequiresVerification ? " (verified before approval)" : "")</option> }</select>
            <span asp-validation-for="PaymentMethodId" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="Source" class="form-label">Source</label>
            <select asp-for="Source" class="form-select" asp-items="EnumText.Options<PaymentSource>()"></select>
            <div class="form-text">Customer-submitted proof always goes to verification first.</div></div>
        <div class="col-12 col-lg-4"><label asp-for="Amount" class="form-label">Amount (@s)</label><input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" /><span asp-validation-for="Amount" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="PaymentDate" class="form-label"></label><input asp-for="PaymentDate" type="date" class="form-control" /><span asp-validation-for="PaymentDate" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="Reference" class="form-label">Reference <span class="text-danger d-none" data-reference-required>(required)</span></label><input asp-for="Reference" class="form-control" maxlength="100" placeholder="Bank / transaction / cheque number" /><span asp-validation-for="Reference" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4" data-cheque-only><label asp-for="BankName" class="form-label"></label><input asp-for="BankName" class="form-control" maxlength="150" /><span asp-validation-for="BankName" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4" data-cheque-only><label asp-for="InstrumentDate" class="form-label"></label><input asp-for="InstrumentDate" type="date" class="form-control" /><span asp-validation-for="InstrumentDate" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="PayerName" class="form-label"></label><input asp-for="PayerName" class="form-control" maxlength="200" /></div>
        <div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="2" maxlength="1000"></textarea></div>
    </div></div></div>
    <partial name="_AllocationEditor" model='new AllocationEditorModel("AllocationMode", Model.AllocationMode, Model.ChargeId, Model.RemainderToAdvance, c.OpenLines, c.Charges, Model.Lines, s, true)' />
    <p class="text-muted small">Submitting does not post the payment. @(c.Status == AgreementStatus.Active ? "Another user approves it; the allocation above is applied then and the receipt is issued." : "")</p>
    <div class="d-flex flex-wrap gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Submit payment</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/payments.js" asp-append-version="true"></script> }
