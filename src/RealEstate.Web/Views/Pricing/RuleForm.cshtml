@model RuleFormViewModel
@using RealEstate.Domain.Enums
@{ ViewData["Title"] = "New pricing rule"; }
<h1 class="h3 mb-1">New pricing rule</h1>
<p class="text-muted">@Model.ProjectName</p>
<div class="alert alert-info small">Pricing rules cannot be edited once created, so earlier prices stay reproducible. To change a price, retire the rule and create a new one. Customer-negotiated rules become active only after approval.</div>
<form asp-action="CreateRule" method="post" data-loading-form>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="ProjectId" />
    <div class="card mb-3"><div class="card-header fw-semibold">Rule</div><div class="card-body"><div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger small"></span>
            <div class="form-text">Premiums and charges with the same code compete: the most specific level wins.</div></div>
        <div class="col-12 col-lg-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="Kind" class="form-label"></label><select asp-for="Kind" asp-items="Html.GetEnumSelectList<PricingRuleKind>()" class="form-select"></select></div>
        <div class="col-12 col-lg-4" id="factorGroup"><label asp-for="Factor" class="form-label"></label><select asp-for="Factor" asp-items="Html.GetEnumSelectList<PricingFactor>()" class="form-select"></select>
            <div class="form-text">Corner, road, park and commercial premiums apply only to matching properties.</div></div>
        <div class="col-12 col-lg-4"><label asp-for="Scope" class="form-label">Applies at level</label><select asp-for="Scope" asp-items="Html.GetEnumSelectList<PricingScope>()" class="form-select"></select></div>
        <div class="col-12 col-lg-4 scope-field" data-scope="Block"><label asp-for="BlockId" class="form-label">Block</label><select asp-for="BlockId" class="form-select"><option value="">- Choose -</option>@foreach (var z in Model.Blocks) { <option value="@z.Id">@z.Name</option> }</select><span asp-validation-for="BlockId" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4 scope-field" data-scope="Street"><label asp-for="StreetId" class="form-label">Street</label><select asp-for="StreetId" class="form-select"><option value="">- Choose -</option>@foreach (var z in Model.Streets) { <option value="@z.Id">@z.Name</option> }</select><span asp-validation-for="StreetId" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4 scope-field" data-scope="PropertyCategory"><label asp-for="CategoryId" class="form-label">Property category</label><select asp-for="CategoryId" class="form-select"><option value="">- Choose -</option>@foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }</select><span asp-validation-for="CategoryId" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4 scope-field" data-scope="Property"><label asp-for="PropertyId" class="form-label">Property</label>
            @if (Model.Properties.Count < 100) { <select asp-for="PropertyId" class="form-select"><option value="">- Choose -</option>@foreach (var x in Model.Properties) { <option value="@x.PropertyId">@x.PropertyCode (@x.Size.ToString("0.####") @x.Unit)</option> }</select> }
            else { <input asp-for="PropertyId" type="number" min="1" class="form-control" placeholder="Property ID (see property pricing list)" /> }
            <span asp-validation-for="PropertyId" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4 scope-field" data-scope="Customer"><label asp-for="CustomerId" class="form-label">Customer ID</label><input asp-for="CustomerId" type="number" min="1" class="form-control" /><span asp-validation-for="CustomerId" class="text-danger small"></span>
            <div class="form-text">Customer records arrive in a later phase; the ID is stored as given.</div></div>
        <div class="col-12 col-lg-4 scope-field" data-scope="Customer"><label asp-for="CustomerReference" class="form-label">Customer name / reference</label><input asp-for="CustomerReference" class="form-control" /></div>
    </div></div></div>
    <div class="card mb-3"><div class="card-header fw-semibold">Amount and validity</div><div class="card-body"><div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="Method" class="form-label"></label><select asp-for="Method" asp-items="Html.GetEnumSelectList<PricingMethod>()" class="form-select"></select>
            <div class="form-text">Per unit = amount per unit of size. Fixed = flat money (base rate: total price). Percentage = of the size-based price.</div></div>
        <div class="col-12 col-lg-4"><label asp-for="Value" class="form-label">Value</label><input asp-for="Value" type="number" step="0.0001" min="0" class="form-control" /><span asp-validation-for="Value" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="Unit" class="form-label">Measurement unit</label><select asp-for="Unit" asp-items="Html.GetEnumSelectList<MeasurementUnit>()" class="form-select"><option value="">-</option></select>
            <div class="form-text">Unit of the per-unit rate and of any size conditions.</div></div>
        <div class="col-12 col-lg-4"><label asp-for="EffectiveFrom" class="form-label">Effective from</label><input asp-for="EffectiveFrom" type="date" class="form-control" /><span asp-validation-for="EffectiveFrom" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="EffectiveTo" class="form-label">Effective to (optional)</label><input asp-for="EffectiveTo" type="date" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="Priority" class="form-label"></label><input asp-for="Priority" type="number" min="0" max="1000" class="form-control" /><div class="form-text">Breaks ties between rules of the same level.</div></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
    </div></div></div>
    <div class="card mb-3"><div class="card-header fw-semibold">Conditions (optional)</div><div class="card-body"><p class="text-muted small">The rule applies only to properties that meet every condition entered. Sizes are in the measurement unit above.</p><div class="row g-3">
        <div class="col-6 col-lg-3"><label asp-for="MinSize" class="form-label">Minimum size</label><input asp-for="MinSize" type="number" step="0.0001" min="0" class="form-control" /></div>
        <div class="col-6 col-lg-3"><label asp-for="MaxSize" class="form-label">Maximum size</label><input asp-for="MaxSize" type="number" step="0.0001" min="0" class="form-control" /></div>
        <div class="col-6 col-lg-3"><label asp-for="MinFloor" class="form-label">Minimum floor</label><input asp-for="MinFloor" type="number" class="form-control" /></div>
        <div class="col-6 col-lg-3"><label asp-for="MaxFloor" class="form-label">Maximum floor</label><input asp-for="MaxFloor" type="number" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="ConditionTypeId" class="form-label">Property type</label><select asp-for="ConditionTypeId" class="form-select"><option value="">Any</option>@foreach (var t in Model.Types) { <option value="@t.Id">@t.Name</option> }</select></div>
        <div class="col-12 col-lg-4"><label asp-for="ConditionSectorId" class="form-label">Sector</label><select asp-for="ConditionSectorId" class="form-select"><option value="">Any</option>@foreach (var z in Model.Sectors) { <option value="@z.Id">@z.Name</option> }</select></div>
        <div class="col-12 col-lg-4"><label asp-for="ConditionDevelopment" class="form-label">Development status</label><select asp-for="ConditionDevelopment" asp-items="Html.GetEnumSelectList<DevelopmentStatus>()" class="form-select"><option value="">Any</option></select></div>
        <div class="col-12 col-lg-4"><label asp-for="ConditionCorner" class="form-label">Corner</label><select asp-for="ConditionCorner" class="form-select"><option value="">Any</option><option value="true">Yes</option><option value="false">No</option></select></div>
        <div class="col-12 col-lg-4"><label asp-for="ConditionMainRoad" class="form-label">Main road facing</label><select asp-for="ConditionMainRoad" class="form-select"><option value="">Any</option><option value="true">Yes</option><option value="false">No</option></select></div>
        <div class="col-12 col-lg-4"><label asp-for="ConditionPark" class="form-label">Park facing</label><select asp-for="ConditionPark" class="form-select"><option value="">Any</option><option value="true">Yes</option><option value="false">No</option></select></div>
    </div></div></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Create rule</button><a class="btn btn-outline-secondary" asp-action="Rules" asp-route-projectId="@Model.ProjectId">Cancel</a></div>
</form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(function () {
  var scope = document.getElementById('Scope'), kind = document.getElementById('Kind');
  function sync() {
    document.querySelectorAll('.scope-field').forEach(function (e) { e.style.display = e.dataset.scope === scope.value ? '' : 'none'; });
    document.getElementById('factorGroup').style.display = kind.value === 'BaseRate' ? 'none' : '';
  }
  scope.addEventListener('change', sync); kind.addEventListener('change', sync); sync();
})();
</script>
}
