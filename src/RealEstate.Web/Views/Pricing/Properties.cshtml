@model PropertyPricesViewModel
@using RealEstate.Domain.Enums
@inject RealEstate.Web.Services.UiPermissions Ui
@{ ViewData["Title"] = "Property pricing"; await Ui.LoadAsync(); var f = Model.Filter; var p = Model.Prices;
   var route = new Dictionary<string, string?> { ["search"] = f.Search, ["projectId"] = f.ProjectId?.ToString(), ["status"] = f.Status?.ToString(), ["published"] = f.Published?.ToString().ToLower() }; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1 class="h3 mb-0">Pricing</h1>
    @if (Ui.Has("pricing.manage") && f.ProjectId is { } pid) { <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#publishAllModal">Publish prices for project</button> }</div>
<partial name="_PricingTabs" model='"Properties"' />
<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-12 col-md-3"><input type="search" name="search" value="@f.Search" class="form-control" placeholder="Code or number" aria-label="Search properties" /></div>
    <div class="col-6 col-md-3"><select name="projectId" class="form-select" aria-label="Project"><option value="">All projects</option>@foreach (var x in Model.Projects) { <option value="@x.Id" selected="@(f.ProjectId == x.Id)">@x.ProjectCode</option> }</select></div>
    <div class="col-6 col-md-2"><select name="status" class="form-select" aria-label="Status"><option value="">All statuses</option>@foreach (var s in Enum.GetValues<PropertyStatus>()) { <option value="@s" selected="@(f.Status == s)">@s</option> }</select></div>
    <div class="col-6 col-md-2"><select name="published" class="form-select" aria-label="Price published"><option value="">Priced or not</option><option value="true" selected="@(f.Published == true)">Priced</option><option value="false" selected="@(f.Published == false)">Not priced</option></select></div>
    <div class="col-6 col-md-2 d-flex gap-2"><button class="btn btn-outline-primary flex-fill" type="submit">Filter</button><a class="btn btn-outline-secondary" asp-action="Properties">Clear</a></div>
</form>
@if (p.Items.Count == 0) { <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No properties found.</p></div> }
else
{
<div class="card"><div class="table-responsive-md"><table class="table table-hover align-middle mb-0 table-stack">
    <thead><tr><th>Code</th><th>Project</th><th>Type</th><th class="text-end">Size</th><th>Status</th><th class="text-end">Published price</th><th>Published</th><th></th></tr></thead><tbody>
    @foreach (var x in p.Items)
    {
        <tr><td data-label="Code">@x.PropertyCode</td><td data-label="Project">@x.ProjectCode</td><td data-label="Type">@x.TypeName</td><td data-label="Size" class="text-end">@x.Size.ToString("0.####") @x.Unit</td>
            <td data-label="Status"><partial name="_StatusBadge" model="x.Status" /></td>
            <td data-label="Published price" class="text-end">@(x.PublishedPrice is { } pr ? pr.ToString("N2") + (x.IsOverridden ? " *" : "") : "Not priced")</td>
            <td data-label="Published">@(x.PublishedAtUtc?.ToString("yyyy-MM-dd") ?? "-")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Property" asp-route-id="@x.PropertyId">Pricing</a></td></tr>
    }
    </tbody></table></div></div>
<div class="small text-muted mt-1">* includes an approved price override.</div>
<partial name="_Pager" model='(p.Page, p.TotalPages, p.TotalCount, "properties", route, "page")' />
}
@if (Ui.Has("pricing.manage") && f.ProjectId is { } projectId)
{
    <div class="modal fade" id="publishAllModal" tabindex="-1" aria-labelledby="publishAllTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" asp-action="PublishProject" method="post">
        <input type="hidden" name="projectId" value="@projectId" />
        <div class="modal-header"><h2 class="modal-title fs-5" id="publishAllTitle">Publish prices for the project</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"><p>Calculates today's price for every available, reserved or cancelled property. Booked and sold properties are never repriced. Unchanged prices are left as they are.</p><label class="form-label" for="pubReason">Reason (optional)</label><input id="pubReason" name="reason" class="form-control" maxlength="1000" /></div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Publish prices</button></div></form></div></div>
}
