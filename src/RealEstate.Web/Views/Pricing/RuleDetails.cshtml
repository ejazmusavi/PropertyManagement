@model RealEstate.Application.Pricing.PricingRuleDto
@using RealEstate.Domain.Enums
@inject RealEstate.Web.Services.UiPermissions Ui
@{ ViewData["Title"] = Model.Code; await Ui.LoadAsync(); var canManage = Ui.Has("pricing.manage"); }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div><h1 class="h3 mb-1">@Model.Code <span class="badge @(Model.Status == PricingRuleStatus.Active ? "text-bg-success" : Model.Status == PricingRuleStatus.PendingApproval ? "text-bg-warning" : "text-bg-secondary")">@Model.Status</span></h1><div class="text-muted">@Model.Name · @Model.ProjectCode</div></div>
    <div class="d-flex flex-wrap gap-2">
        @if (canManage && Model.Status == PricingRuleStatus.Active) { <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#retireModal">Retire rule</button> }
        @if (Model.ApprovalId is { } aid) { <a class="btn btn-outline-primary" asp-action="ApprovalDetails" asp-route-id="@aid">Approval request</a> }
        <a class="btn btn-outline-secondary" asp-action="Rules" asp-route-projectId="@Model.ProjectId">Back to rules</a>
    </div>
</div>
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<div class="row g-3 mb-3">
    <div class="col-12 col-lg-7"><div class="card h-100"><div class="card-header fw-semibold">Rule</div><div class="card-body"><dl class="row mb-0">
        <dt class="col-sm-4">Kind / factor</dt><dd class="col-sm-8">@Model.Kind@(Model.Kind == PricingRuleKind.Premium ? " · " + Model.Factor : "")</dd>
        <dt class="col-sm-4">Applies at</dt><dd class="col-sm-8">@Model.Scope@(Model.BlockName != null ? ": " + Model.BlockName : "")@(Model.StreetName != null ? ": " + Model.StreetName : "")@(Model.CategoryName != null ? ": " + Model.CategoryName : "")@(Model.PropertyCode != null ? ": " + Model.PropertyCode : "")@(Model.CustomerId != null ? ": customer " + Model.CustomerId + (Model.CustomerReference != null ? " (" + Model.CustomerReference + ")" : "") : "")</dd>
        <dt class="col-sm-4">Method / value</dt><dd class="col-sm-8">@Model.Method · @Model.Value.ToString("0.####")@(Model.Method == PricingMethod.Percentage ? "%" : "")@(Model.Unit != null ? " per " + Model.Unit : "")</dd>
        <dt class="col-sm-4">Effective</dt><dd class="col-sm-8">@Model.EffectiveFrom.ToString("yyyy-MM-dd") – @(Model.EffectiveTo?.ToString("yyyy-MM-dd") ?? "open")</dd>
        <dt class="col-sm-4">Priority</dt><dd class="col-sm-8">@Model.Priority</dd>
        <dt class="col-sm-4">Description</dt><dd class="col-sm-8">@(Model.Description ?? "-")</dd>
        @if (Model.StatusReason != null) { <dt class="col-sm-4">Status reason</dt><dd class="col-sm-8">@Model.StatusReason</dd> }
        <dt class="col-sm-4">Created</dt><dd class="col-sm-8">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") by @Model.CreatedBy</dd>
    </dl></div></div></div>
    <div class="col-12 col-lg-5"><div class="card h-100"><div class="card-header fw-semibold">Conditions</div><div class="card-body">
        @if (Model.Conditions.Count == 0) { <span class="text-muted">None: applies to every property at this level.</span> }
        else { <ul class="list-unstyled mb-0">@foreach (var c in Model.Conditions) { <li>@c.Field: <strong>@c.Value</strong></li> }</ul> }
    </div></div></div>
</div>
@if (canManage && Model.Status != PricingRuleStatus.Rejected)
{
    <div class="card mb-3"><div class="card-header fw-semibold">Name and description</div><div class="card-body">
        <form asp-action="UpdateRule" asp-route-id="@Model.Id" method="post" class="row g-2">
            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
            <div class="col-12 col-lg-4"><label class="form-label" for="ruleName">Name</label><input id="ruleName" name="name" value="@Model.Name" class="form-control" required maxlength="150" /></div>
            <div class="col-12 col-lg-6"><label class="form-label" for="ruleDesc">Description</label><input id="ruleDesc" name="description" value="@Model.Description" class="form-control" maxlength="1000" /></div>
            <div class="col-12 col-lg-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100" type="submit">Save</button></div>
        </form><div class="form-text">Amounts, levels, conditions and dates are fixed to keep earlier prices reproducible.</div></div></div>
}
@if (canManage && Model.Status == PricingRuleStatus.Active)
{
    <div class="modal fade" id="retireModal" tabindex="-1" aria-labelledby="retireTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" asp-action="RetireRule" asp-route-id="@Model.Id" method="post">
        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
        <div class="modal-header"><h2 class="modal-title fs-5" id="retireTitle">Retire rule @Model.Code</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"><p>The rule stops applying from today. Calculations for earlier dates still use it.</p><label class="form-label" for="retireReason">Reason</label><input id="retireReason" name="reason" class="form-control" required maxlength="1000" /></div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Retire rule</button></div></form></div></div>
}
