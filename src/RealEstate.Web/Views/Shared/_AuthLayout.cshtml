<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Real Estate ERP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
<div class="auth-wrap">
    <section class="auth-hero d-none d-lg-flex" aria-hidden="true">
        <div class="auth-hero-inner">
            <span class="brand-mark brand-mark-lg"><i class="bi bi-buildings-fill"></i></span>
            <h2>Manage every project, sale and rupee in one place.</h2>
            <p>Land, inventory, bookings, installments, payments and accounting &mdash; unified for your real estate business.</p>
            <ul class="auth-points">
                <li><i class="bi bi-check-circle-fill"></i>Project &amp; inventory control</li>
                <li><i class="bi bi-check-circle-fill"></i>Installments &amp; recovery tracking</li>
                <li><i class="bi bi-check-circle-fill"></i>Double-entry accounting &amp; reports</li>
            </ul>
        </div>
        <div class="auth-skyline"></div>
    </section>
    <main class="auth-panel" role="main">
        <div class="auth-card">
            <div class="d-flex align-items-center gap-2 mb-4 d-lg-none"><span class="brand-mark"><i class="bi bi-buildings-fill"></i></span><strong class="font-display">Real Estate ERP</strong></div>
            @RenderBody()
        </div>
    </main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
