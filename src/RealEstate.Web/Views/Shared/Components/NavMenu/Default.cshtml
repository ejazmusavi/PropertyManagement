@model IReadOnlyList<string>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(params string[] c) => c.Any(x => string.Equals(controller, x, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
    @if (Model.Contains("projects.view"))
    {
        <li class="nav-item"><a class="nav-link @Active("Projects", "Land")" asp-controller="Projects" asp-action="Index">Projects</a></li>
    }
    @if (Model.Contains("inventory.view"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Inventory</li>
        <li class="nav-item"><a class="nav-link @Active("Inventory")" asp-controller="Inventory" asp-action="Index">Property dashboard</a></li>
        <li class="nav-item"><a class="nav-link @Active("Properties")" asp-controller="Properties" asp-action="Index">Properties</a></li>
        <li class="nav-item"><a class="nav-link @Active("PropertySetup")" asp-controller="PropertySetup" asp-action="Types">Types &amp; blocks</a></li>
    }
    @if (Model.Contains("pricing.view"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Pricing</li>
        <li class="nav-item"><a class="nav-link @Active("Pricing")" asp-controller="Pricing" asp-action="Rules">Pricing engine</a></li>
    }
    @if (Model.Contains("customers.view") || Model.Contains("bookings.view"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Sales</li>
        @if (Model.Contains("customers.view")) { <li class="nav-item"><a class="nav-link @Active("Customers")" asp-controller="Customers" asp-action="Index">Customers</a></li> }
        @if (Model.Contains("bookings.view")) { <li class="nav-item"><a class="nav-link @Active("Bookings")" asp-controller="Bookings" asp-action="Index">Bookings</a></li> }
        @if (Model.Contains("bookings.approve")) { <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="Approvals">Booking approvals</a></li> }
    }
    @if (Model.Contains("installments.view"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Installments</li>
        <li class="nav-item"><a class="nav-link @Active("InstallmentAgreements")" asp-controller="InstallmentAgreements" asp-action="Index">Agreement schedules</a></li>
        <li class="nav-item"><a class="nav-link @Active("InstallmentPlans")" asp-controller="InstallmentPlans" asp-action="Index">Installment plans</a></li>
        <li class="nav-item"><a class="nav-link @Active("LateFeeRules")" asp-controller="LateFeeRules" asp-action="Index">Late fee rules</a></li>
        <li class="nav-item"><a class="nav-link @Active("AgreementAmendments")" asp-controller="AgreementAmendments" asp-action="Pending">Amendments and waivers</a></li>
    }
    @if (Model.Contains("payments.view") || Model.Contains("ledgers.view") || Model.Contains("recovery.view") || Model.Contains("recovery.followup"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Payments</li>
        @if (Model.Contains("payments.collect")) { <li class="nav-item"><a class="nav-link" asp-controller="Payments" asp-action="Create">Collect payment</a></li> }
        @if (Model.Contains("payments.view")) { <li class="nav-item"><a class="nav-link @Active("Payments")" asp-controller="Payments" asp-action="Index">Payments</a></li> }
        @if (Model.Contains("payments.verify")) { <li class="nav-item"><a class="nav-link" asp-controller="Payments" asp-action="Index" asp-route-status="PendingVerification">Payment verification</a></li> }
        @if (Model.Contains("payments.approve")) { <li class="nav-item"><a class="nav-link" asp-controller="Payments" asp-action="Index" asp-route-status="PendingApproval">Payment approval</a></li> }
        @if (Model.Contains("payments.view")) { <li class="nav-item"><a class="nav-link @Active("Receipts")" asp-controller="Receipts" asp-action="Index">Receipts</a></li> }
        @if (Model.Contains("payments.view")) { <li class="nav-item"><a class="nav-link @Active("Refunds")" asp-controller="Refunds" asp-action="Index">Refunds</a></li> }
        @if (Model.Contains("recovery.view")) { <li class="nav-item"><a class="nav-link @Active("Recovery")" asp-controller="Recovery" asp-action="Index">Recovery dashboard</a></li> }
        @if (Model.Contains("recovery.view") || Model.Contains("recovery.followup"))
        {
            <li class="nav-item"><a class="nav-link" asp-controller="Recovery" asp-action="Overdue">Overdue installments</a></li>
            <li class="nav-item"><a class="nav-link" asp-controller="Recovery" asp-action="FollowUps">Follow-up history</a></li>
        }
    }
    @if (Model.Contains("expenses.view") || Model.Contains("vendors.view") || Model.Contains("govfees.view"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Expenses</li>
        @if (Model.Contains("expenses.view")) { <li class="nav-item"><a class="nav-link @Active("Expenses")" asp-controller="Expenses" asp-action="Dashboard">Expense dashboard</a></li> }
        @if (Model.Contains("expenses.manage")) { <li class="nav-item"><a class="nav-link" asp-controller="Expenses" asp-action="Create">Register expense</a></li> }
        @if (Model.Contains("expenses.view")) { <li class="nav-item"><a class="nav-link" asp-controller="Expenses" asp-action="Index">Expenses</a></li> }
        @if (Model.Contains("expenses.approve")) { <li class="nav-item"><a class="nav-link" asp-controller="Expenses" asp-action="Approvals">Expense approvals</a></li> }
        @if (Model.Contains("expenses.view")) { <li class="nav-item"><a class="nav-link @Active("ExpenseCategories")" asp-controller="ExpenseCategories" asp-action="Index">Expense categories</a></li> }
        @if (Model.Contains("vendors.view")) { <li class="nav-item"><a class="nav-link @Active("Vendors")" asp-controller="Vendors" asp-action="Index">Vendors</a></li> }
        @if (Model.Contains("vendors.view")) { <li class="nav-item"><a class="nav-link @Active("VendorInvoices")" asp-controller="VendorInvoices" asp-action="Index">Vendor invoices</a></li> }
        @if (Model.Contains("expenses.view")) { <li class="nav-item"><a class="nav-link @Active("VendorPayments")" asp-controller="VendorPayments" asp-action="Index">Vendor payments</a></li> }
        @if (Model.Contains("govfees.view")) { <li class="nav-item"><a class="nav-link @Active("GovernmentFees")" asp-controller="GovernmentFees" asp-action="Index">Government fees</a></li> }
        @if (Model.Contains("govfees.view")) { <li class="nav-item"><a class="nav-link @Active("GovernmentFeeTypes")" asp-controller="GovernmentFeeTypes" asp-action="Index">Fee configuration</a></li> }
        @if (Model.Contains("govfees.view")) { <li class="nav-item"><a class="nav-link @Active("GovernmentPayments")" asp-controller="GovernmentPayments" asp-action="Index">Government payments</a></li> }
    }
    @if (Model.Contains("accounting.view") || Model.Contains("accounting.reports"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Accounting</li>
        @if (Model.Contains("accounting.view")) { <li class="nav-item"><a class="nav-link @Active("Accounting")" asp-controller="Accounting" asp-action="Index">Accounting dashboard</a></li> }
        @if (Model.Contains("accounting.view")) { <li class="nav-item"><a class="nav-link" asp-controller="Accounting" asp-action="Accounts">Chart of accounts</a></li> }
        @if (Model.Contains("accounting.view")) { <li class="nav-item"><a class="nav-link" asp-controller="Accounting" asp-action="Groups">Account groups</a></li> }
        @if (Model.Contains("accounting.view")) { <li class="nav-item"><a class="nav-link @Active("Journals")" asp-controller="Journals" asp-action="Index">Journal entries</a></li> }
        @if (Model.Contains("accounting.journals.approve")) { <li class="nav-item"><a class="nav-link" asp-controller="Journals" asp-action="Approvals">Journal approvals</a></li> }
        @if (Model.Contains("accounting.view")) { <li class="nav-item"><a class="nav-link @Active("PostingRules")" asp-controller="PostingRules" asp-action="Index">Posting rules</a></li> }
        @if (Model.Contains("accounting.view")) { <li class="nav-item"><a class="nav-link" asp-controller="PostingRules" asp-action="Queue">Automatic postings</a></li> }
        @if (Model.Contains("accounting.view")) { <li class="nav-item"><a class="nav-link @Active("Banking")" asp-controller="Banking" asp-action="Index">Bank reconciliation</a></li> }
        @if (Model.Contains("accounting.view")) { <li class="nav-item"><a class="nav-link @Active("FiscalYears")" asp-controller="FiscalYears" asp-action="Index">Financial years and periods</a></li> }
        @if (Model.Contains("accounting.reports")) { <li class="nav-item"><a class="nav-link" asp-controller="FinancialReports" asp-action="TrialBalance">Trial balance</a></li> }
        @if (Model.Contains("accounting.reports")) { <li class="nav-item"><a class="nav-link" asp-controller="FinancialReports" asp-action="GeneralLedger">General ledger</a></li> }
        @if (Model.Contains("accounting.reports")) { <li class="nav-item"><a class="nav-link @Active("FinancialReports")" asp-controller="FinancialReports" asp-action="Index">Financial statements</a></li> }
    }
    @if (Model.Contains("company.view"))
    {
        <li class="nav-item"><a class="nav-link @Active("Company")" asp-controller="Company" asp-action="Index">Company</a></li>
    }
    @if (Model.Contains("users.view"))
    {
        <li class="nav-item"><a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index">Users</a></li>
    }
    @if (Model.Contains("roles.view"))
    {
        <li class="nav-item"><a class="nav-link @Active("Roles")" asp-controller="Roles" asp-action="Index">Roles</a></li>
        <li class="nav-item"><a class="nav-link @Active("Permissions")" asp-controller="Permissions" asp-action="Index">Permissions</a></li>
    }
    <li class="nav-item"><a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">My profile</a></li>
</ul>
