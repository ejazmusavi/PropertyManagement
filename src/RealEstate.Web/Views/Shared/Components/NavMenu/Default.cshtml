@model IReadOnlyList<string>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
    @if (Model.Contains("users.view"))
    {
        <li class="nav-item"><a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index">Users</a></li>
    }
    <li class="nav-item"><a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">My profile</a></li>
</ul>
