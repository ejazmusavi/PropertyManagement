@model IReadOnlyList<string>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(params string[] c) => c.Any(x => string.Equals(controller, x, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
    @if (Model.Contains("projects.view"))
    {
        <li class="nav-item"><a class="nav-link @Active("Projects", "Land")" asp-controller="Projects" asp-action="Index">Projects</a></li>
    }
    @if (Model.Contains("inventory.view"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Inventory</li>
        <li class="nav-item"><a class="nav-link @Active("Inventory")" asp-controller="Inventory" asp-action="Index">Property dashboard</a></li>
        <li class="nav-item"><a class="nav-link @Active("Properties")" asp-controller="Properties" asp-action="Index">Properties</a></li>
        <li class="nav-item"><a class="nav-link @Active("PropertySetup")" asp-controller="PropertySetup" asp-action="Types">Types &amp; blocks</a></li>
    }
    @if (Model.Contains("pricing.view"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Pricing</li>
        <li class="nav-item"><a class="nav-link @Active("Pricing")" asp-controller="Pricing" asp-action="Rules">Pricing engine</a></li>
    }
    @if (Model.Contains("customers.view") || Model.Contains("bookings.view"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Sales</li>
        @if (Model.Contains("customers.view")) { <li class="nav-item"><a class="nav-link @Active("Customers")" asp-controller="Customers" asp-action="Index">Customers</a></li> }
        @if (Model.Contains("bookings.view")) { <li class="nav-item"><a class="nav-link @Active("Bookings")" asp-controller="Bookings" asp-action="Index">Bookings</a></li> }
        @if (Model.Contains("bookings.approve")) { <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="Approvals">Booking approvals</a></li> }
    }
    @if (Model.Contains("installments.view"))
    {
        <li class="nav-item mt-2 px-2 text-uppercase small text-muted">Installments</li>
        <li class="nav-item"><a class="nav-link @Active("InstallmentAgreements")" asp-controller="InstallmentAgreements" asp-action="Index">Agreement schedules</a></li>
        <li class="nav-item"><a class="nav-link @Active("InstallmentPlans")" asp-controller="InstallmentPlans" asp-action="Index">Installment plans</a></li>
        <li class="nav-item"><a class="nav-link @Active("LateFeeRules")" asp-controller="LateFeeRules" asp-action="Index">Late fee rules</a></li>
        <li class="nav-item"><a class="nav-link @Active("AgreementAmendments")" asp-controller="AgreementAmendments" asp-action="Pending">Amendments and waivers</a></li>
    }
    @if (Model.Contains("company.view"))
    {
        <li class="nav-item"><a class="nav-link @Active("Company")" asp-controller="Company" asp-action="Index">Company</a></li>
    }
    @if (Model.Contains("users.view"))
    {
        <li class="nav-item"><a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index">Users</a></li>
    }
    @if (Model.Contains("roles.view"))
    {
        <li class="nav-item"><a class="nav-link @Active("Roles")" asp-controller="Roles" asp-action="Index">Roles</a></li>
        <li class="nav-item"><a class="nav-link @Active("Permissions")" asp-controller="Permissions" asp-action="Index">Permissions</a></li>
    }
    <li class="nav-item"><a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">My profile</a></li>
</ul>
