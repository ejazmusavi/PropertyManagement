@model GovFeeListViewModel
@using RealEstate.Domain.Enums
@using RealEstate.Domain.Common
@inject RealEstate.Web.Services.UiPermissions Ui
@{ ViewData["Title"] = "Government fees"; await Ui.LoadAsync(); var f = Model.Filter; var p = Model.Fees; var sm = Model.Summary; var s = sm.CurrencySymbol;
   var route = new Dictionary<string, string?> { ["search"] = f.Search, ["projectId"] = f.ProjectId?.ToString(), ["feeTypeId"] = f.FeeTypeId?.ToString(), ["status"] = f.Status?.ToString(),
       ["collectionPending"] = f.CollectionPending ? "true" : null, ["paymentPending"] = f.PaymentPending ? "true" : null }; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Government fees</h1>
    <div class="d-flex flex-wrap gap-2">
        @if (Ui.Has(Permissions.GovFeesAssess)) { <a class="btn btn-primary" asp-action="Create">Assess a fee</a> }
        <a class="btn btn-outline-secondary" asp-controller="GovernmentFeeTypes" asp-action="Index">Fee configuration</a>
        <a class="btn btn-outline-secondary" asp-controller="GovernmentPayments" asp-action="Index">Government payments</a>
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Customer liability</div><div class="fs-5 fw-semibold">@s @sm.CustomerLiability.ToString("N2")</div><div class="small text-muted">of @s @sm.TotalAssessed.ToString("N2") assessed (@sm.Assessments)</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Collected from customers</div><div class="fs-5 fw-semibold">@s @sm.CustomerCollected.ToString("N2")</div><div class="small text-muted">Outstanding: @s @sm.CustomerOutstanding.ToString("N2")</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Payable to government</div><div class="fs-5 fw-semibold">@s @sm.GovernmentPayable.ToString("N2")</div><div class="small text-muted">Paid: @s @sm.PaidToGovernment.ToString("N2")</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Company-borne expense</div><div class="fs-5 fw-semibold">@s @sm.CompanyBorne.ToString("N2")</div></div></div></div>
</div>
<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-12 col-lg-3"><input type="search" name="search" value="@f.Search" class="form-control" placeholder="Assessment, agreement, customer" aria-label="Search fees" /></div>
    <div class="col-6 col-lg-2"><select name="projectId" class="form-select" aria-label="Project"><option value="">All projects</option>@foreach (var x in Model.Projects) { <option value="@x.Id" selected="@(f.ProjectId == x.Id)">@x.ProjectCode</option> }</select></div>
    <div class="col-6 col-lg-2"><select name="feeTypeId" class="form-select" aria-label="Fee type"><option value="">All fee types</option>@foreach (var x in Model.Types) { <option value="@x.Id" selected="@(f.FeeTypeId == x.Id)">@x.Name</option> }</select></div>
    <div class="col-6 col-lg-2"><select name="status" class="form-select" aria-label="Status"><option value="">All statuses</option>@foreach (var st in Enum.GetValues<GovernmentFeeAssessmentStatus>()) { <option value="@st" selected="@(f.Status == st)">@st.Label()</option> }</select></div>
    <div class="col-12 col-lg-1"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
    <div class="col-12 d-flex flex-wrap gap-3">
        <div class="form-check"><input class="form-check-input" type="checkbox" name="collectionPending" value="true" id="cp" checked="@f.CollectionPending" /><label class="form-check-label" for="cp">Customer collection pending</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" name="paymentPending" value="true" id="pp" checked="@f.PaymentPending" /><label class="form-check-label" for="pp">Government payment pending</label></div>
    </div>
</form>
@if (p.Items.Count == 0)
{
    <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No government fee assessments found.</p></div>
}
else
{
    <div class="card"><div class="table-responsive-md"><table class="table table-hover align-middle mb-0 table-stack">
        <thead><tr><th>Assessment</th><th>Customer / agreement</th><th>Fee</th><th class="text-end">Amount</th><th class="text-end">Customer owes</th><th class="text-end">Govt payable</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var x in p.Items)
        {
            <tr><td data-label="Assessment">@x.AssessmentNumber<div class="small text-muted">@x.ProjectCode</div></td><td data-label="Customer">@x.CustomerName<div class="small text-muted">@x.AgreementNumber</div></td><td data-label="Fee">@x.FeeTypeName</td>
                <td data-label="Amount" class="text-end">@x.Amount.ToString("N2")<div class="small text-muted">company @x.CompanyBorne.ToString("N2")</div></td>
                <td data-label="Customer owes" class="text-end">@x.CustomerOutstanding.ToString("N2")</td><td data-label="Govt payable" class="text-end">@x.GovernmentPayable.ToString("N2")</td><td data-label="Status">@x.Status.Label()</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Open</a></td></tr>
        }
        </tbody></table></div></div>
    <partial name="_Pager" model='(p.Page, p.TotalPages, p.TotalCount, "assessments", route, "page")' />
}
