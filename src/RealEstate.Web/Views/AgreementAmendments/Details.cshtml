@model AmendmentDetailsViewModel
@using RealEstate.Domain.Enums
@{ var m = Model.Amendment; var s = m.CurrencySymbol; ViewData["Title"] = $"Amendment #{m.Id}"; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div><h1 class="h3 mb-1">@m.AmendmentType amendment <partial name="_AmendmentStatusBadge" model="m.Status" /></h1>
        <div class="text-muted">Agreement @m.AgreementNumber &middot; booking @m.BookingNumber &middot; requested @m.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") by @m.RequestedBy</div></div>
    <div class="d-flex flex-wrap gap-2">
        @if (m.CanDecide)
        {
            @if (!m.IsStale) { <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">Approve</button> }
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">Reject</button>
        }
        @if (m.CanCancel) { <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#cancelModal">Cancel request</button> }
        <a class="btn btn-outline-secondary" asp-controller="InstallmentAgreements" asp-action="Details" asp-route-id="@m.AgreementId">Agreement installments</a>
        <a class="btn btn-outline-secondary" asp-controller="InstallmentAgreements" asp-action="History" asp-route-id="@m.AgreementId">Schedule history</a>
    </div>
</div>
@if (m.Status == AmendmentStatus.Pending && !m.CanDecide && !m.CanCancel) { <div class="alert alert-info">This amendment is waiting for approval by another user with the approval permission.</div> }
@if (m.Status == AmendmentStatus.Pending && !m.CanDecide && m.CanCancel) { <div class="alert alert-info">You requested this amendment, so another approver must decide it. You can still cancel the request.</div> }
@if (m.IsStale) { <div class="alert alert-warning">The schedule changed after this amendment was requested, so it can no longer be approved. Reject or cancel it and request it again.</div> }
<div class="row g-3 mb-3">
    <div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Request</div><div class="card-body"><dl class="row mb-0">
        <dt class="col-sm-4">Summary</dt><dd class="col-sm-8">@m.Summary</dd>
        <dt class="col-sm-4">Reason</dt><dd class="col-sm-8">@m.Reason</dd>
        <dt class="col-sm-4">Request data</dt><dd class="col-sm-8"><details><summary class="small text-muted">Show the submitted values</summary><pre class="small mb-0" style="white-space:pre-wrap">@m.Details</pre></details></dd>
        <dt class="col-sm-4">Based on</dt><dd class="col-sm-8">Schedule version @(m.BaseScheduleVersion?.ToString() ?? "-")@(m.ResultScheduleVersion is { } rv ? $" → version {rv}" : "")</dd>
    </dl></div></div></div>
    <div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Decision</div><div class="card-body"><dl class="row mb-0">
        <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@m.Status.Label()</dd>
        <dt class="col-sm-4">Decided by</dt><dd class="col-sm-8">@(m.ApprovedBy ?? "-")@(m.DecidedAtUtc is { } da ? " on " + da.ToString("yyyy-MM-dd HH:mm") : "")</dd>
        <dt class="col-sm-4">Comments</dt><dd class="col-sm-8">@(m.DecisionComments ?? "-")</dd>
        @if (m.Waiver is { } w) { <dt class="col-sm-4">Waiver</dt><dd class="col-sm-8">@w.Kind.Label() of @s @w.Amount.ToString("N2") on @w.ItemDescription (@w.Status.Label())</dd> }
    </dl></div></div></div>
</div>
@if (m.Changes.Count > 0)
{
    <div class="card mb-3"><div class="card-header fw-semibold">Changes (@m.Changes.Count)</div>
    <div class="table-responsive-md"><table class="table table-sm align-middle mb-0 table-stack"><thead><tr><th>Operation</th><th>Charge</th><th>Old due</th><th>New due</th><th class="text-end">Old amount</th><th class="text-end">New amount</th><th>Note</th></tr></thead><tbody>
    @foreach (var c in m.Changes)
    {
        <tr><td data-label="Operation">@c.Operation.Label()</td><td data-label="Charge">@c.ChargeDescription</td><td data-label="Old due">@(c.OldDueDate?.ToString("yyyy-MM-dd") ?? "-")</td><td data-label="New due">@(c.NewDueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
            <td data-label="Old amount" class="text-end">@(c.OldAmount?.ToString("N2") ?? "-")</td><td data-label="New amount" class="text-end">@(c.NewAmount?.ToString("N2") ?? "-")</td><td data-label="Note">@c.Note</td></tr>
    }</tbody></table></div></div>
}
@if (m.PreviewError is not null) { <div class="alert alert-danger" role="alert"><strong>The new schedule cannot be previewed.</strong> @m.PreviewError</div> }
@if (m.Preview is { } pv)
{
    <h2 class="h5">@(m.Status == AmendmentStatus.Pending ? "Preview of the new schedule" : "Resulting schedule")</h2>
    <partial name="_Reconciliation" model="(pv, s)" />
    <div class="card mb-3"><div class="card-header fw-semibold">Installments (@pv.Items.Count)</div><partial name="_ScheduleTable" model="(pv.Items, s)" /></div>
}
@if (m.CanDecide)
{
    <div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" asp-action="Approve" asp-route-id="@m.AgreementId" asp-route-amendmentId="@m.Id" method="post" data-loading-form><input type="hidden" name="rowVersion" value="@m.RowVersion" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="approveTitle">Approve amendment</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body"><p>Approving applies the amendment and activates a new schedule version. This cannot be undone; a later amendment is needed to change it again.</p><label class="form-label" for="approveComments">Comments (optional)</label><input id="approveComments" name="comments" class="form-control" maxlength="1000" /></div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Approve</button></div></form></div></div>
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" asp-action="Reject" asp-route-id="@m.AgreementId" asp-route-amendmentId="@m.Id" method="post"><input type="hidden" name="rowVersion" value="@m.RowVersion" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="rejectTitle">Reject amendment</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body"><label class="form-label" for="rejectComments">Comment (required)</label><textarea id="rejectComments" name="comments" class="form-control" rows="3" required minlength="3" maxlength="1000"></textarea></div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Reject</button></div></form></div></div>
}
@if (m.CanCancel)
{
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" asp-action="Cancel" asp-route-id="@m.AgreementId" asp-route-amendmentId="@m.Id" method="post"><input type="hidden" name="rowVersion" value="@m.RowVersion" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="cancelTitle">Cancel request</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body"><p>Withdraw this pending amendment? The schedule is not changed.</p><label class="form-label" for="cancelComments">Comment (optional)</label><input id="cancelComments" name="comments" class="form-control" maxlength="1000" /></div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep request</button><button type="submit" class="btn btn-danger">Cancel request</button></div></form></div></div>
}
