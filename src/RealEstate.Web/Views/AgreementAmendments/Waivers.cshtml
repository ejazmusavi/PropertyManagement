@model WaiverListViewModel
@using RealEstate.Domain.Enums
@{ ViewData["Title"] = "Waiver approvals"; var p = Model.Waivers;
   var route = new Dictionary<string, string?> { ["status"] = Model.Status?.ToString(), ["projectId"] = Model.ProjectId?.ToString() }; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Waiver approvals</h1>
    <div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Pending">Pending amendments</a><a class="btn btn-outline-secondary" asp-controller="InstallmentAgreements" asp-action="Index">Agreements</a></div>
</div>
<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-6 col-lg-3"><select name="status" class="form-select" aria-label="Status"><option value="">All statuses</option>@foreach (var s in Enum.GetValues<WaiverStatus>()) { <option value="@s" selected="@(Model.Status == s)">@s.Label()</option> }</select></div>
    <div class="col-6 col-lg-3"><select name="projectId" class="form-select" aria-label="Project"><option value="">All projects</option>@foreach (var x in Model.Projects) { <option value="@x.Id" selected="@(Model.ProjectId == x.Id)">@x.ProjectCode</option> }</select></div>
    <div class="col-12 col-lg-2"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
</form>
@if (p.Items.Count == 0)
{
    <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No waivers found.</p></div>
}
else
{
    <div class="card"><div class="table-responsive-md"><table class="table table-hover align-middle mb-0 table-stack">
        <thead><tr><th>Requested</th><th>Agreement</th><th>Installment</th><th>Kind</th><th class="text-end">Amount</th><th>Reason</th><th>Requested by</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var x in p.Items)
        {
            <tr><td data-label="Requested">@x.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td data-label="Agreement">@x.AgreementNumber</td><td data-label="Installment">@x.ItemDescription</td><td data-label="Kind">@x.Kind.Label()</td>
                <td data-label="Amount" class="text-end">@x.Amount.ToString("N2")</td><td data-label="Reason">@x.Reason</td><td data-label="Requested by">@x.RequestedBy</td>
                <td data-label="Status">@x.Status.Label()@(x.DecidedBy is not null ? " by " + x.DecidedBy : "")</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.AgreementId" asp-route-amendmentId="@x.AmendmentId">@(x.Status == WaiverStatus.Pending ? "Review" : "Details")</a></td></tr>
        }
        </tbody></table></div></div>
    <partial name="_Pager" model='(p.Page, p.TotalPages, p.TotalCount, "waivers", route, "page")' />
}
