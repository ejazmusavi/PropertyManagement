@model TransferFormViewModel
@{ ViewData["Title"] = "Fund transfer"; }
<h1 class="h3 mb-3">Fund transfer</h1>
@if (Model.MoneyAccounts.Count < 2)
{
    <div class="empty-state card card-body"><p class="mb-1">Transfers move money between registered bank and cash accounts. At least two such accounts are needed@(Model.CompanyLevelAllowed ? "" : ", and transfers need access to all projects").</p>
        <a asp-controller="Banking" asp-action="Index">Bank and cash accounts</a></div>
}
else
{
<form asp-action="Transfer" method="post" class="card card-body">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <input type="hidden" asp-for="IdempotencyKey" />
    <div class="row g-3">
        <div class="col-12 col-md-4"><label asp-for="FromAccountId" class="form-label"></label><select asp-for="FromAccountId" class="form-select"><option value="0">Choose...</option>@foreach (var a in Model.MoneyAccounts) { <option value="@a.Id">@a.Name (@a.Code)</option> }</select></div>
        <div class="col-12 col-md-4"><label asp-for="ToAccountId" class="form-label"></label><select asp-for="ToAccountId" class="form-select"><option value="0">Choose...</option>@foreach (var a in Model.MoneyAccounts) { <option value="@a.Id">@a.Name (@a.Code)</option> }</select></div>
        <div class="col-12 col-md-4"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control" /><span asp-validation-for="Amount" class="text-danger small"></span></div>
        <div class="col-12 col-md-4"><label asp-for="TransferDate" class="form-label"></label><input asp-for="TransferDate" type="date" class="form-control" /></div>
        <div class="col-12 col-md-4"><label asp-for="ProjectId" class="form-label"></label><select asp-for="ProjectId" class="form-select">@if (Model.CompanyLevelAllowed) { <option value="">Company level</option> }@foreach (var p in Model.Projects) { <option value="@p.Id">@p.ProjectCode - @p.ProjectName</option> }</select></div>
        <div class="col-12 col-md-4"><label asp-for="Reference" class="form-label">Reference (deposit slip, cheque)</label><input asp-for="Reference" class="form-control" /></div>
        <div class="col-12"><label asp-for="Narration" class="form-label"></label><input asp-for="Narration" class="form-control" /><span asp-validation-for="Narration" class="text-danger small"></span></div>
    </div>
    <div class="alert alert-info small mt-3 mb-3">The journal is built from the approved posting rule for bank or cash transfers and goes to another user for approval.</div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Submit transfer for approval</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
