@model UserFormViewModel
@{ var editing = Model.Id.HasValue; ViewData["Title"] = editing ? "Edit user" : "New user"; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<div class="card"><div class="card-body">
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-loading-form>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" readonly="@editing" autocomplete="off" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /></div>
        @if (!editing)
        {
            <div class="col-12 col-lg-4"><label asp-for="Password" class="form-label">Initial password</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><div class="form-text">At least 12 characters with upper, lower, digit and symbol.</div><span asp-validation-for="Password" class="text-danger small"></span></div>
        }
        <div class="col-12 col-lg-4 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
        <div class="col-12"><label class="form-label">Roles</label>
            <div class="row">
            @foreach (var r in Model.AllRoles)
            {
                <div class="col-12 col-md-6 col-lg-4"><div class="form-check"><input class="form-check-input" type="checkbox" name="Roles" value="@r.Name" id="role-@r.Id" checked="@Model.Roles.Contains(r.Name)" /><label class="form-check-label" for="role-@r.Id">@r.Name</label></div></div>
            }
            </div></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Save user</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
