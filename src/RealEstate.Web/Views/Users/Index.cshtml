@model UserListViewModel
@inject RealEstate.Web.Services.UiPermissions Ui
@{ ViewData["Title"] = "Users"; var p = Model.Users; await Ui.LoadAsync(); }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Users</h1>
    @if (Ui.Has("users.manage")) { <a class="btn btn-primary" asp-action="Create">New user</a> }
    <form method="get" class="d-flex gap-2" role="search">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search name or email" aria-label="Search users" />
        <button class="btn btn-outline-primary" type="submit">Search</button>
        @if (!string.IsNullOrEmpty(Model.Search)) { <a class="btn btn-outline-secondary" asp-action="Index">Clear</a> }
    </form>
</div>
@if (p.Items.Count == 0)
{
    <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No users match your search.</p></div>
}
else
{
    <div class="card"><div class="table-responsive-md">
        <table class="table table-hover align-middle mb-0 table-stack">
            <thead><tr>
                <th><a asp-action="Index" asp-route-search="@Model.Search" asp-route-sortBy="name" asp-route-desc="@(Model.SortBy is null or "name" && !Model.Descending)">Name</a></th>
                <th><a asp-action="Index" asp-route-search="@Model.Search" asp-route-sortBy="email" asp-route-desc="@(Model.SortBy == "email" && !Model.Descending)">Email</a></th>
                <th>Roles</th><th>Status</th>
                <th><a asp-action="Index" asp-route-search="@Model.Search" asp-route-sortBy="lastlogin" asp-route-desc="@(Model.SortBy == "lastlogin" && !Model.Descending)">Last sign-in (UTC)</a></th>
            <th></th></tr></thead>
            <tbody>
            @foreach (var u in p.Items)
            {
                <tr>
                    <td data-label="Name">@u.FullName</td>
                    <td data-label="Email">@u.Email</td>
                    <td data-label="Roles">@(u.Roles.Count == 0 ? "-" : string.Join(", ", u.Roles))</td>
                    <td data-label="Status"><span class="badge @(u.IsActive ? "text-bg-success" : "text-bg-secondary")">@(u.IsActive ? "Active" : "Inactive")</span></td>
                    <td data-label="Last sign-in">@(u.LastLoginAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td class="text-end">@if (Ui.Has("users.manage")) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Edit</a> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
    <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Pagination">
        <span class="text-muted small">Page @p.Page of @Math.Max(p.TotalPages, 1) &middot; @p.TotalCount users</span>
        <div class="btn-group">
            <a class="btn btn-outline-secondary @(p.HasPrevious ? "" : "disabled")" asp-action="Index" asp-route-page="@(p.Page - 1)" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy" asp-route-desc="@Model.Descending" aria-disabled="@(!p.HasPrevious)">Previous</a>
            <a class="btn btn-outline-secondary @(p.HasNext ? "" : "disabled")" asp-action="Index" asp-route-page="@(p.Page + 1)" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy" asp-route-desc="@Model.Descending" aria-disabled="@(!p.HasNext)">Next</a>
        </div>
    </nav>
}
