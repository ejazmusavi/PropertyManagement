@model MyNotificationsViewModel
@using RealEstate.Web.Controllers
@{ ViewData["Title"] = "My notifications"; var p = Model.Inbox; var route = new Dictionary<string, string?>();
   var grid = new PreferencesViewModel { Title = "", FormAction = "SavePreferences", Staff = true, Cells = Model.Preferences }; }
<h1 class="h3 mb-3">My notifications</h1>
<div class="row g-3">
    <div class="col-12 col-xl-8">
        @if (p.Items.Count == 0) { <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No notifications yet. Switch on the daily summary to receive one every morning.</p></div> }
        else
        {
            <div class="card"><ul class="list-group list-group-flush">
            @foreach (var x in p.Items)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start gap-2">
                    <div><div class="@(x.ReadAtUtc is null ? "fw-semibold" : "")">@x.Title</div><div class="small">@x.Body</div><div class="small text-muted">@x.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div></div>
                    @if (x.ReadAtUtc is null) { <form asp-action="MarkRead" method="post"><input type="hidden" name="id" value="@x.Id" /><button class="btn btn-sm btn-outline-secondary" type="submit">Mark read</button></form> }
                </li>
            }
            </ul></div>
            <partial name="_Pager" model='(p.Page, p.TotalPages, p.TotalCount, "notifications", route, "page")' />
        }
    </div>
    <div class="col-12 col-xl-4">
        <div class="card"><div class="card-header fw-semibold">Daily summary</div><div class="card-body">
            <p class="small text-muted">A short summary of yesterday's collections, overdue installments and items waiting for action. Needs the reports permission and access to all projects.</p>
            <form asp-action="SavePreferences" method="post" data-loading-form>
                @foreach (var c in Model.Preferences)
                {
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="enabled" id="pref-@c.Channel" value="@PreferenceForm.CellKey(c)" checked="@c.IsEnabled" /><label class="form-check-label" for="pref-@c.Channel">@(c.Channel == RealEstate.Domain.Enums.NotificationChannel.InApp ? "In this inbox" : "By e-mail")</label></div>
                }
                <button type="submit" class="btn btn-primary mt-3"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Save</button>
            </form></div></div>
    </div>
</div>
