@model ReceiptDetailsViewModel
@using RealEstate.Domain.Enums
@inject RealEstate.Web.Services.UiPermissions Ui
@{ var r = Model.Receipt; ViewData["Title"] = "Receipt " + r.ReceiptNumber; await Ui.LoadAsync(); }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div><h1 class="h3 mb-1">Receipt @r.ReceiptNumber <span class="badge @(r.PaymentStatus == PaymentStatus.Reversed ? "text-bg-danger" : "text-bg-success")">@r.PaymentStatus.Label()</span></h1>
        <div class="text-muted">Payment @r.PaymentNumber &middot; agreement @r.AgreementNumber &middot; project @r.ProjectCode</div></div>
    <div class="d-flex flex-wrap gap-2">
        @if (Ui.Has("payments.receipts"))
        {
            <form asp-action="Pdf" asp-route-id="@r.Id" method="post"><button type="submit" class="btn btn-primary">Download PDF</button></form>
        }
        <a class="btn btn-outline-secondary" href="/Payments/Details/@r.PaymentId">Payment details</a>
        <a class="btn btn-outline-secondary" asp-action="Index">All receipts</a>
    </div>
</div>
@if (r.PaymentStatus == PaymentStatus.Reversed) { <div class="alert alert-danger">The payment behind this receipt has been reversed. The receipt is no longer valid and is printed with a REVERSED banner.</div> }
<div class="row g-3">
    <div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Receipt</div><div class="card-body"><dl class="row mb-0">
        <dt class="col-sm-5">Receipt number</dt><dd class="col-sm-7">@r.ReceiptNumber</dd>
        <dt class="col-sm-5">Payment</dt><dd class="col-sm-7"><a href="/Payments/Details/@r.PaymentId">@r.PaymentNumber</a></dd>
        <dt class="col-sm-5">Payment date</dt><dd class="col-sm-7">@r.PaymentDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-5">Amount</dt><dd class="col-sm-7">@r.Amount.ToString("N2")</dd>
        <dt class="col-sm-5">Method</dt><dd class="col-sm-7">@r.MethodName</dd>
        <dt class="col-sm-5">Customer</dt><dd class="col-sm-7">@r.CustomerName</dd>
        <dt class="col-sm-5">Issued</dt><dd class="col-sm-7">@r.IssuedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC by @r.IssuedBy</dd>
    </dl></div></div></div>
    <div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Printing</div><div class="card-body">
        <dl class="row mb-3">
            <dt class="col-sm-5">Copies printed</dt><dd class="col-sm-7">@r.CopiesPrinted</dd>
            <dt class="col-sm-5">Last printed</dt><dd class="col-sm-7">@(r.LastPrintedAtUtc is { } lp ? lp.ToString("yyyy-MM-dd HH:mm") + " UTC by " + r.LastPrintedBy : "Never")</dd>
        </dl>
        <p class="text-muted small mb-0">The first PDF downloaded is the <strong>original</strong> receipt. Every later download is stamped <strong>DUPLICATE COPY</strong> with its copy number, so only one original ever exists. Each download is counted and recorded in the audit log.</p>
    </div></div></div>
</div>
