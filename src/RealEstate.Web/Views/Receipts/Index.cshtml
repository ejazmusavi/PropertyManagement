@model ReceiptListViewModel
@using RealEstate.Domain.Enums
@{ ViewData["Title"] = "Receipts"; var f = Model.Filter; var p = Model.Receipts;
   var route = new Dictionary<string, string?> { ["search"] = f.Search, ["projectId"] = f.ProjectId?.ToString(), ["from"] = f.From?.ToString("yyyy-MM-dd"), ["to"] = f.To?.ToString("yyyy-MM-dd") }; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Receipts</h1>
    <a class="btn btn-outline-secondary" href="/Payments">Payments</a>
</div>
<form method="get" asp-action="Index" class="row g-2 mb-3" role="search">
    <div class="col-12 col-lg-3"><input type="search" name="search" value="@f.Search" class="form-control" placeholder="Receipt, payment, agreement, customer" aria-label="Search receipts" /></div>
    <div class="col-12 col-md-4 col-lg-2"><select name="projectId" class="form-select" aria-label="Project"><option value="">All projects</option>@foreach (var x in Model.Projects) { <option value="@x.Id" selected="@(f.ProjectId == x.Id)">@x.ProjectCode</option> }</select></div>
    <div class="col-6 col-md-4 col-lg-2"><input type="date" name="from" value="@f.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="Payment date from" /></div>
    <div class="col-6 col-md-4 col-lg-2"><input type="date" name="to" value="@f.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="Payment date to" /></div>
    <div class="col-12 col-lg-2"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
</form>
@if (p.Items.Count == 0)
{
    <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No receipts found. A receipt is issued when a payment is approved and posted.</p></div>
}
else
{
    <div class="card"><div class="table-responsive-md"><table class="table table-hover align-middle mb-0 table-stack">
        <thead><tr><th>Receipt</th><th>Payment</th><th>Date</th><th>Customer</th><th>Agreement</th><th>Project</th><th>Method</th><th class="text-end">Amount</th><th class="text-end">Copies</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var x in p.Items)
        {
            <tr><td data-label="Receipt">@x.ReceiptNumber</td><td data-label="Payment"><a href="/Payments/Details/@x.PaymentId">@x.PaymentNumber</a></td><td data-label="Date">@x.PaymentDate.ToString("yyyy-MM-dd")</td>
                <td data-label="Customer">@x.CustomerName</td><td data-label="Agreement">@x.AgreementNumber</td><td data-label="Project">@x.ProjectCode</td><td data-label="Method">@x.MethodName</td>
                <td data-label="Amount" class="text-end">@x.Amount.ToString("N2")</td><td data-label="Copies" class="text-end">@x.CopiesPrinted</td>
                <td data-label="Status"><span class="badge @(x.PaymentStatus == PaymentStatus.Reversed ? "text-bg-danger" : "text-bg-success")">@x.PaymentStatus.Label()</span></td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Details</a></td></tr>
        }
        </tbody></table></div></div>
    <partial name="_Pager" model='(p.Page, p.TotalPages, p.TotalCount, "receipts", route, "page")' />
}
