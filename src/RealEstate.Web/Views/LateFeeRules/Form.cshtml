@model LateFeeFormViewModel
@using RealEstate.Domain.Enums
@{ var edit = Model.Id is not null; ViewData["Title"] = edit ? "Edit late fee rule" : "New late fee rule"; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
@if (Model.IsInUse) { <div class="alert alert-warning">This rule is used by plans or agreements. Changing it affects the late fee charged on schedules that reference it from now on; every change is audited.</div> }
<form asp-action="@(edit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-loading-form>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="RowVersion" />
    @if (edit) { <input type="hidden" asp-for="ProjectId" /> }
    <div class="card mb-3"><div class="card-body"><div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" maxlength="40" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-12 col-lg-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" maxlength="150" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="ProjectId" class="form-label"></label>
            @if (edit) { <input class="form-control" value="@(Model.Projects.FirstOrDefault(x => x.Id == Model.ProjectId)?.ProjectCode ?? "All projects")" disabled /> }
            else { <select asp-for="ProjectId" class="form-select"><option value="">All projects</option>@foreach (var x in Model.Projects) { <option value="@x.Id" selected="@(Model.ProjectId == x.Id)">@x.ProjectCode – @x.ProjectName</option> }</select> }</div>
        <div class="col-12 col-lg-4"><label asp-for="Method" class="form-label"></label><select asp-for="Method" class="form-select" asp-items="EnumText.Options<LateFeeMethod>()"></select></div>
        <div class="col-12 col-lg-4"><label asp-for="Value" class="form-label"></label><input asp-for="Value" type="number" step="0.0001" min="0" class="form-control" /><span asp-validation-for="Value" class="text-danger small"></span><div class="form-text">An amount for fixed methods, a percentage for percent methods.</div></div>
        <div class="col-12 col-lg-4"><label asp-for="MaxAmount" class="form-label"></label><input asp-for="MaxAmount" type="number" step="0.01" min="0" class="form-control" /></div>
        <div class="col-12 col-lg-4"><label asp-for="MaxPercentOfInstallment" class="form-label"></label><input asp-for="MaxPercentOfInstallment" type="number" step="0.01" min="0" max="100" class="form-control" /></div>
        <div class="col-12 col-lg-4 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" maxlength="500" /></div>
    </div></div></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Save</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
