@model PostingQueueViewModel
@using RealEstate.Domain.Enums
@{ ViewData["Title"] = "Automatic postings"; var f = Model.Filter; var p = Model.Items; var sm = Model.Summary;
   var route = new Dictionary<string, string?> { ["search"] = f.Search, ["status"] = f.Status?.ToString(), ["eventType"] = f.EventType?.ToString(), ["projectId"] = f.ProjectId?.ToString() }; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Automatic postings</h1>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanProcess)
        {
            <form asp-action="Run" method="post" class="d-inline"><button type="submit" class="btn btn-primary">Post pending events</button></form>
            <form asp-action="Run" method="post" class="d-inline"><input type="hidden" name="retryFailed" value="true" /><button type="submit" class="btn btn-outline-primary">Post pending and retry failed</button></form>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Posting rules</a>
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><a class="card card-body text-decoration-none" asp-route-status="Pending"><div class="text-muted small">Pending</div><div class="fs-4 fw-semibold">@sm.Pending</div></a></div>
    <div class="col-6 col-lg-3"><a class="card card-body text-decoration-none" asp-route-status="Failed"><div class="text-muted small">Failed (need a rule, an open period or a decision)</div><div class="fs-4 fw-semibold text-danger">@sm.Failed</div></a></div>
    <div class="col-6 col-lg-3"><a class="card card-body text-decoration-none" asp-route-status="Posted"><div class="text-muted small">Posted</div><div class="fs-4 fw-semibold">@sm.Posted</div></a></div>
    <div class="col-6 col-lg-3"><a class="card card-body text-decoration-none" asp-route-status="Skipped"><div class="text-muted small">Not posted (policy decision)</div><div class="fs-4 fw-semibold">@sm.Skipped</div></a></div>
</div>
<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-12 col-lg-3"><input type="search" name="search" value="@f.Search" class="form-control" placeholder="Document number" aria-label="Search events" /></div>
    <div class="col-6 col-lg-2"><select name="status" class="form-select" aria-label="Status"><option value="">All statuses</option>@foreach (var s in Enum.GetValues<AccountingPostingStatus>()) { <option value="@s" selected="@(f.Status == s)">@s.Label()</option> }</select></div>
    <div class="col-6 col-lg-3"><select name="eventType" class="form-select" aria-label="Event"><option value="">All events</option>@foreach (var e in Enum.GetValues<AccountingEventType>()) { <option value="@e" selected="@(f.EventType == e)">@e.Label()</option> }</select></div>
    <div class="col-6 col-lg-2"><select name="projectId" class="form-select" aria-label="Project"><option value="">All projects</option>@foreach (var x in Model.Projects) { <option value="@x.Id" selected="@(f.ProjectId == x.Id)">@x.ProjectCode</option> }</select></div>
    <div class="col-6 col-lg-2"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
</form>
@if (p.Items.Count == 0)
{
    <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No accounting events found.</p></div>
}
else
{
    <div class="card"><div class="table-responsive-md"><table class="table table-hover align-middle mb-0 table-stack">
        <thead><tr><th>Event</th><th>Source</th><th>Project</th><th>Date</th><th class="text-end">Amount</th><th>Status</th><th>Result</th><th></th></tr></thead><tbody>
        @foreach (var e in p.Items)
        {
            <tr><td data-label="Event">@e.EventLabel<div class="small text-muted">#@e.Id</div></td><td data-label="Source">@e.SourceType #@e.SourceId</td><td data-label="Project">@e.ProjectCode</td>
                <td data-label="Date">@e.EventDate.ToString("yyyy-MM-dd")</td><td data-label="Amount" class="text-end">@e.Amount.ToString("N2")</td>
                <td data-label="Status">@e.Status.Label()@if (e.Attempts > 1) { <div class="small text-muted">@e.Attempts attempts</div> }</td>
                <td data-label="Result" class="small">@if (e.JournalEntryId is { } jid) { <a asp-controller="Journals" asp-action="Details" asp-route-id="@jid">@e.JournalNumber</a> }
                    else if (e.SkipReason is not null) { @e.SkipReason } else if (e.LastError is not null) { <span class="text-danger">@e.LastError</span> }
                    <details><summary class="text-muted">Payload</summary><code class="small text-break">@e.PayloadJson</code></details></td>
                <td class="text-end text-nowrap">@if (Model.CanProcess && e.Status is AccountingPostingStatus.Pending or AccountingPostingStatus.Failed)
                    {
                        <form asp-action="Retry" asp-route-id="@e.Id" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-primary">Post now</button></form>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#skipModal" data-skip-id="@e.Id" data-skip-label="@e.EventLabel #@e.Id">Not posted</button>
                    }</td></tr>
        }
        </tbody></table></div></div>
    <partial name="_Pager" model='(p.Page, p.TotalPages, p.TotalCount, "events", route, "page")' />
}
@if (Model.CanProcess)
{
    <div class="modal fade" id="skipModal" tabindex="-1" aria-labelledby="skipTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="skipForm" asp-action="Skip" asp-route-id="0" method="post">
            <div class="modal-header"><h2 class="modal-title fs-5" id="skipTitle">Mark event as not posted</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body"><p>Use this only when the approved accounting policy says <strong id="skipLabel"></strong> creates no journal. This is final and audited.</p>
                <label class="form-label" for="sr">Reason (at least 5 characters)</label><textarea id="sr" name="reason" class="form-control" required minlength="5" maxlength="500"></textarea></div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Mark as not posted</button></div></form></div></div>
}
@section Scripts {<script>
    (function () {
        var modal = document.getElementById('skipModal'); if (!modal) return;
        modal.addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget; var form = document.getElementById('skipForm');
            form.action = form.action.replace(/\/\d+$/, '/' + b.getAttribute('data-skip-id'));
            document.getElementById('skipLabel').textContent = b.getAttribute('data-skip-label');
        });
    })();
</script>}
