@model ReportCatalogViewModel
@{ ViewData["Title"] = "Reports"; }
<h1 class="h3 mb-1">Reports</h1>
<p class="text-muted">Every report supports date range, project, block, customer, transaction type, payment method and status where the filter has a meaning for it, and can be exported to PDF and Excel.</p>
@if (Model.Reports.Count == 0)
{
    <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">You do not have access to any report.</p></div>
}
else
{
    <div class="row g-3">
        @foreach (var g in Model.Reports.GroupBy(r => r.Group))
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-header fw-semibold">@g.Key</div>
                    <div class="list-group list-group-flush">
                        @foreach (var r in g)
                        {
                            <a class="list-group-item list-group-item-action" asp-action="Run" asp-route-key="@r.Key"><span class="d-block">@r.Title</span><span class="small text-muted">@r.Description</span></a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
