@model GovFeeTypeFormViewModel
@using RealEstate.Domain.Enums
@{ var edit = Model.Id is not null; ViewData["Title"] = edit ? "Edit government fee type" : "New government fee type"; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-action="@(edit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-loading-form>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="RowVersion" /><input type="hidden" asp-for="IsSystem" />
    @if (edit) { <input type="hidden" asp-for="ProjectId" /><input type="hidden" asp-for="Code" /><input type="hidden" asp-for="Kind" /> }
    <div class="card mb-3"><div class="card-body"><div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" maxlength="40" disabled="@edit" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-12 col-lg-5"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" maxlength="120" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-12 col-lg-3"><label asp-for="Kind" class="form-label"></label><select asp-for="Kind" class="form-select" asp-items="EnumText.Options<GovernmentFeeKind>()" disabled="@edit"></select></div>
        <div class="col-12 col-lg-4"><label asp-for="ProjectId" class="form-label"></label>
            @if (edit) { <input class="form-control" value="@(Model.Projects.FirstOrDefault(x => x.Id == Model.ProjectId)?.ProjectCode ?? "Company-wide")" disabled /> }
            else { <select asp-for="ProjectId" class="form-select"><option value="">Company-wide</option>@foreach (var x in Model.Projects) { <option value="@x.Id" selected="@(Model.ProjectId == x.Id)">@x.ProjectCode &ndash; @x.ProjectName</option> }</select> }</div>
        <div class="col-12 col-lg-4"><label asp-for="Method" class="form-label"></label><select asp-for="Method" class="form-select" asp-items="EnumText.Options<FeeCalculationMethod>()" id="feeMethod"></select></div>
        <div class="col-12 col-lg-4"><label asp-for="DefaultBearer" class="form-label"></label><select asp-for="DefaultBearer" class="form-select" asp-items="EnumText.Options<FeeBearer>()"></select></div>
        <div class="col-12 col-lg-4" data-method="Fixed"><label asp-for="FixedAmount" class="form-label"></label><input asp-for="FixedAmount" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="FixedAmount" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4" data-method="PercentOfBasis"><label asp-for="Rate" class="form-label"></label><input asp-for="Rate" type="number" step="0.0001" min="0" max="100" class="form-control" /><span asp-validation-for="Rate" class="text-danger small"></span></div>
        <div class="col-12 col-lg-8"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" maxlength="500" /></div>
        <div class="col-12 col-lg-4 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
    </div></div></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Save</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(function () {
  var sel = document.getElementById('feeMethod'); if (!sel) return;
  var names = { '1': 'Manual', '2': 'Fixed', '3': 'PercentOfBasis' };
  function sync() { var m = names[sel.value]; document.querySelectorAll('[data-method]').forEach(function (e) { e.style.display = e.dataset.method === m ? '' : 'none'; }); }
  sel.addEventListener('change', sync); sync();
})();
</script>
}
