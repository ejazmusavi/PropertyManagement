@model GovFeeTypeListViewModel
@using RealEstate.Domain.Enums
@using RealEstate.Domain.Common
@inject RealEstate.Web.Services.UiPermissions Ui
@{ ViewData["Title"] = "Government fee configuration"; await Ui.LoadAsync(); }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Government fee configuration</h1>
    <div class="d-flex flex-wrap gap-2">
        @if (Ui.Has(Permissions.GovFeesSetup)) { <a class="btn btn-primary" asp-action="Create">New fee type</a> }
        <a class="btn btn-outline-secondary" asp-controller="GovernmentFees" asp-action="Index">Fee assessments</a>
    </div>
</div>
<p class="text-muted">Fee types define how a government fee is calculated (manual entry, a fixed amount or a percentage of an amount) and who bears it by default. Changes apply to new assessments only.</p>
<div class="card"><div class="table-responsive-md"><table class="table align-middle mb-0 table-stack">
    <thead><tr><th>Fee type</th><th>Kind</th><th>Calculation</th><th>Default bearer</th><th>Scope</th><th>Status</th><th></th></tr></thead><tbody>
    @foreach (var t in Model.Types)
    {
        <tr><td data-label="Fee type">@t.Name @if (t.IsSystem) { <span class="badge text-bg-light border">Standard</span> }<div class="small text-muted">@t.Code</div></td><td data-label="Kind">@t.Kind.Label()</td>
            <td data-label="Calculation">@t.Method.Label()@(t.Method == FeeCalculationMethod.Fixed ? " (" + t.FixedAmount?.ToString("N2") + ")" : t.Method == FeeCalculationMethod.PercentOfBasis ? " (" + t.Rate?.ToString("0.####") + "%)" : "")</td>
            <td data-label="Default bearer">@t.DefaultBearer.Label()</td><td data-label="Scope">@(t.ProjectCode ?? "Company-wide")</td><td data-label="Status">@(t.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">@if (Ui.Has(Permissions.GovFeesSetup)) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@t.Id">Edit</a> }</td></tr>
    }
    </tbody></table></div></div>
