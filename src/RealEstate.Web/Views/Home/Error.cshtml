@model ErrorViewModel
@{ ViewData["Title"] = "Error"; Layout = "_AuthLayout"; }
<h1 class="h4 text-danger">Something went wrong</h1>
<p>The request could not be completed. Please try again.</p>
@if (!string.IsNullOrEmpty(Model.RequestId)) { <p class="text-muted small">Reference: <code>@Model.RequestId</code></p> }
<a class="btn btn-primary" href="/">Back to start</a>
