@model DashboardViewModel
@inject RealEstate.Web.Services.UiPermissions Ui
@{ ViewData["Title"] = "Dashboard"; await Ui.LoadAsync(); var s = Model.Summary;
   var hour = DateTime.Now.Hour; var greet = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening"; }
<section class="hero-banner mb-4">
    <div>
        <div class="hero-eyebrow"><i class="bi bi-building me-1"></i>@(s.CompanyName ?? "Company not configured")</div>
        <h1 class="hero-title">@greet, @Model.FullName</h1>
        <p class="hero-sub mb-0">Here is a snapshot of your workspace today.</p>
    </div>
    <div class="hero-art" aria-hidden="true"><i class="bi bi-buildings"></i></div>
</section>
<div class="row g-3">
    <div class="col-12 col-sm-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="stat-icon tone-blue"><i class="bi bi-people"></i></span><div><div class="stat-label">Active users</div><div class="stat-value">@s.ActiveUsers</div></div></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="stat-icon tone-violet"><i class="bi bi-person-badge"></i></span><div><div class="stat-label">Roles</div><div class="stat-value">@s.Roles</div></div></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="stat-icon tone-green"><i class="bi bi-buildings"></i></span><div><div class="stat-label">My assigned projects</div><div class="stat-value">@s.AssignedProjects</div></div></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="stat-icon tone-amber"><i class="bi bi-clock-history"></i></span><div><div class="stat-label">Last sign-in (UTC)</div><div class="stat-value stat-value-sm">@(s.LastLoginAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div></div></div></div></div>
</div>
<h2 class="section-title mt-4">Quick links</h2>
<div class="row g-3">
    @if (Ui.Has("projects.view")) { <div class="col-6 col-md-4 col-xl-2"><a class="quick-link" asp-controller="Projects" asp-action="Index"><i class="bi bi-buildings"></i><span>Projects</span></a></div> }
    @if (Ui.Has("customers.view")) { <div class="col-6 col-md-4 col-xl-2"><a class="quick-link" asp-controller="Customers" asp-action="Index"><i class="bi bi-person-lines-fill"></i><span>Customers</span></a></div> }
    @if (Ui.Has("bookings.view")) { <div class="col-6 col-md-4 col-xl-2"><a class="quick-link" asp-controller="Bookings" asp-action="Index"><i class="bi bi-journal-bookmark"></i><span>Bookings</span></a></div> }
    @if (Ui.Has("payments.view")) { <div class="col-6 col-md-4 col-xl-2"><a class="quick-link" asp-controller="Payments" asp-action="Index"><i class="bi bi-credit-card"></i><span>Payments</span></a></div> }
    @if (Ui.Has("reports.view")) { <div class="col-6 col-md-4 col-xl-2"><a class="quick-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i><span>Reports</span></a></div> }
    <div class="col-6 col-md-4 col-xl-2"><a class="quick-link" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle"></i><span>My profile</span></a></div>
</div>
