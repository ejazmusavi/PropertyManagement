@model ZonesViewModel
@inject RealEstate.Web.Services.UiPermissions Ui
@{ var kind = Model.Kind.ToString(); var plural = kind + "s"; ViewData["Title"] = plural; await Ui.LoadAsync(); var canEdit = Ui.Has("inventory.setup"); }
<h1 class="h3 mb-3">Project @plural.ToLower()</h1>
<partial name="_SetupTabs" model="plural" />
@if (Model.Projects.Count == 0) { <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No projects available.</p></div> }
else
{
<form method="get" class="row g-2 mb-3"><div class="col-12 col-md-5"><select name="projectId" class="form-select" aria-label="Project" onchange="this.form.submit()">@foreach (var p in Model.Projects) { <option value="@p.Id" selected="@(p.Id == Model.ProjectId)">@p.ProjectCode – @p.ProjectName</option> }</select></div>
    <noscript><div class="col-auto"><button class="btn btn-outline-primary">Show</button></div></noscript></form>
<div class="card"><div class="card-header fw-semibold">@plural</div>
@if (Model.Zones.Count == 0) { <div class="card-body text-muted">No @plural.ToLower() defined for this project.</div> }
else {
<div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>Code</th><th>Name</th><th class="text-end">Properties</th><th>Status</th>@if (canEdit) { <th></th> }</tr></thead><tbody>
@foreach (var z in Model.Zones) { <tr><td data-label="Code">@z.Code</td><td data-label="Name">@z.Name</td><td data-label="Properties" class="text-end">@z.PropertyCount</td><td data-label="Status">@(z.IsActive ? "Active" : "Inactive")</td>
    @if (canEdit) { <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#zoneModal" data-id="@z.Id" data-code="@z.Code" data-name="@z.Name" data-active="@z.IsActive.ToString().ToLower()">Edit</button></td> }</tr> }
</tbody></table></div> }
@if (canEdit) { <div class="card-footer"><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#zoneModal" data-id="" data-code="" data-name="" data-active="true">New @kind.ToLower()</button></div> }</div>
@if (canEdit)
{
<div class="modal fade" id="zoneModal" tabindex="-1" aria-labelledby="zoneTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" asp-action="SaveZone" method="post">
    <input type="hidden" name="kind" value="@Model.Kind" /><input type="hidden" name="projectId" value="@Model.ProjectId" /><input type="hidden" name="id" id="zoneId" />
    <div class="modal-header"><h2 class="modal-title fs-5" id="zoneTitle">@kind</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body"><div class="mb-3"><label class="form-label">Code</label><input name="code" id="zoneCode" class="form-control" required maxlength="30" /></div>
        <div class="mb-3"><label class="form-label">Name</label><input name="name" id="zoneName" class="form-control" required maxlength="100" /></div>
        <div class="form-check"><input type="checkbox" class="form-check-input" id="zoneActive" name="isActive" value="true" /><label class="form-check-label" for="zoneActive">Active</label><input type="hidden" name="isActive" value="false" /></div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div></form></div></div>
}
}
@section Scripts {
<script>
document.getElementById('zoneModal')?.addEventListener('show.bs.modal', function (e) {
  var d = e.relatedTarget.dataset; zoneId.value = d.id; zoneCode.value = d.code; zoneCode.readOnly = !!d.id; zoneName.value = d.name; zoneActive.checked = d.active === 'true';
});
</script>
}
