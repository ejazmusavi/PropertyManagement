@model TypesViewModel
@using RealEstate.Domain.Enums
@inject RealEstate.Web.Services.UiPermissions Ui
@{ ViewData["Title"] = "Property types"; await Ui.LoadAsync(); var canEdit = Ui.Has("inventory.setup"); }
<h1 class="h3 mb-3">Property types and categories</h1>
<partial name="_SetupTabs" model='"Types"' />
<div class="card mb-4"><div class="card-header fw-semibold">Categories</div>
<div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>Code</th><th>Name</th><th>Description</th><th class="text-end">Types</th><th>Status</th>@if (canEdit) { <th></th> }</tr></thead><tbody>
@foreach (var c in Model.Categories) { <tr><td data-label="Code">@c.Code</td><td data-label="Name">@c.Name @(c.IsSystem ? Html.Raw("<span class=\"badge text-bg-secondary\">System</span>") : null)</td><td data-label="Description">@c.Description</td><td data-label="Types" class="text-end">@c.TypeCount</td><td data-label="Status">@(c.IsActive ? "Active" : "Inactive")</td>
    @if (canEdit) { <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#catModal" data-id="@c.Id" data-code="@c.Code" data-name="@c.Name" data-desc="@c.Description" data-active="@c.IsActive.ToString().ToLower()" data-system="@c.IsSystem.ToString().ToLower()">Edit</button></td> }</tr> }
</tbody></table></div>
@if (canEdit) { <div class="card-footer"><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#catModal" data-id="" data-code="" data-name="" data-desc="" data-active="true" data-system="false">New category</button></div> }</div>
<div class="card"><div class="card-header fw-semibold">Property types</div>
<div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>Code</th><th>Name</th><th>Category</th><th>Form</th><th>Floor required</th><th>Status</th>@if (canEdit) { <th></th> }</tr></thead><tbody>
@foreach (var t in Model.Types) { <tr><td data-label="Code">@t.Code</td><td data-label="Name">@t.Name @(t.IsSystem ? Html.Raw("<span class=\"badge text-bg-secondary\">System</span>") : null)</td><td data-label="Category">@t.CategoryName</td><td data-label="Form">@t.Form</td><td data-label="Floor required">@(t.RequiresFloor ? "Yes" : "No")</td><td data-label="Status">@(t.IsActive ? "Active" : "Inactive")</td>
    @if (canEdit) { <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#typeModal" data-id="@t.Id" data-code="@t.Code" data-name="@t.Name" data-cat="@t.CategoryId" data-form="@t.Form" data-floor="@t.RequiresFloor.ToString().ToLower()" data-active="@t.IsActive.ToString().ToLower()" data-system="@t.IsSystem.ToString().ToLower()">Edit</button></td> }</tr> }
</tbody></table></div>
@if (canEdit) { <div class="card-footer"><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#typeModal" data-id="" data-code="" data-name="" data-cat="@Model.Categories.FirstOrDefault(c => c.IsActive)?.Id" data-form="Plot" data-floor="false" data-active="true" data-system="false">New property type</button></div> }</div>
@if (canEdit)
{
<div class="modal fade" id="catModal" tabindex="-1" aria-labelledby="catTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" asp-action="SaveCategory" method="post"><input type="hidden" name="id" id="catId" />
    <div class="modal-header"><h2 class="modal-title fs-5" id="catTitle">Category</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body"><div class="mb-3"><label class="form-label">Code</label><input name="code" id="catCode" class="form-control" required maxlength="30" /></div>
        <div class="mb-3"><label class="form-label">Name</label><input name="name" id="catName" class="form-control" required maxlength="100" /></div>
        <div class="mb-3"><label class="form-label">Description</label><input name="description" id="catDesc" class="form-control" maxlength="500" /></div>
        <div class="form-check"><input type="checkbox" class="form-check-input" id="catActive" name="isActive" value="true" /><label class="form-check-label" for="catActive">Active</label><input type="hidden" name="isActive" value="false" /></div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div></form></div></div>
<div class="modal fade" id="typeModal" tabindex="-1" aria-labelledby="typeTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" asp-action="SaveType" method="post"><input type="hidden" name="id" id="typeId" />
    <div class="modal-header"><h2 class="modal-title fs-5" id="typeTitle">Property type</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body"><div class="mb-3"><label class="form-label">Code</label><input name="code" id="typeCode" class="form-control" required maxlength="30" /></div>
        <div class="mb-3"><label class="form-label">Name</label><input name="name" id="typeName" class="form-control" required maxlength="100" /></div>
        <div class="mb-3"><label class="form-label">Category</label><select name="categoryId" id="typeCat" class="form-select">@foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name@(c.IsActive ? "" : " (inactive)")</option> }</select></div>
        <div class="mb-3"><label class="form-label">Form</label><select name="form" id="typeForm" asp-items="Html.GetEnumSelectList<PropertyForm>()" class="form-select"></select><div class="form-text">Plot, house, apartment or commercial unit (shop/office).</div></div>
        <div class="form-check mb-2"><input type="checkbox" class="form-check-input" id="typeFloor" name="requiresFloor" value="true" /><label class="form-check-label" for="typeFloor">Floor number required</label><input type="hidden" name="requiresFloor" value="false" /></div>
        <div class="form-check"><input type="checkbox" class="form-check-input" id="typeActive" name="isActive" value="true" /><label class="form-check-label" for="typeActive">Active</label><input type="hidden" name="isActive" value="false" /></div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div></form></div></div>
}
@section Scripts {
<script>
document.getElementById('catModal')?.addEventListener('show.bs.modal', function (e) {
  var d = e.relatedTarget.dataset; catId.value = d.id; catCode.value = d.code; catCode.readOnly = !!d.id; catName.value = d.name; catDesc.value = d.desc || '';
  catActive.checked = d.active === 'true'; catActive.style.pointerEvents = d.system === 'true' ? 'none' : ''; catTitle.textContent = d.id ? 'Edit category' : 'New category';
});
document.getElementById('typeModal')?.addEventListener('show.bs.modal', function (e) {
  var d = e.relatedTarget.dataset; typeId.value = d.id; typeCode.value = d.code; typeCode.readOnly = !!d.id; typeName.value = d.name; typeCat.value = d.cat; typeForm.value = d.form === 'Plot' ? '1' : ({House:'2',Apartment:'3',Commercial:'4',Other:'5'}[d.form] || '1');
  typeFloor.checked = d.floor === 'true'; typeActive.checked = d.active === 'true'; typeActive.style.pointerEvents = d.system === 'true' ? 'none' : ''; typeTitle.textContent = d.id ? 'Edit property type' : 'New property type';
});
</script>
}
