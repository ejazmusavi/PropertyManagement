@model ChargeTypeFormViewModel
@using RealEstate.Domain.Enums
@{ var edit = Model.Id is not null; ViewData["Title"] = edit ? "Edit charge type" : "New charge type"; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-action="@(edit ? "EditChargeType" : "CreateChargeType")" asp-route-id="@Model.Id" method="post" data-loading-form>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <div class="card mb-3"><div class="card-body"><div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" maxlength="40" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" maxlength="150" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="Kind" class="form-label">Component kind</label><select asp-for="Kind" class="form-select" asp-items="EnumText.Options<ChargeComponentKind>()"></select></div>
        <div class="col-12 col-lg-4"><label asp-for="DefaultCategory" class="form-label"></label><select asp-for="DefaultCategory" class="form-select" asp-items="EnumText.Options<ChargeCategory>()"></select></div>
        <div class="col-12 col-lg-4"><label asp-for="DefaultFrequency" class="form-label"></label><select asp-for="DefaultFrequency" class="form-select" asp-items="EnumText.Options<ScheduleFrequency>()"></select></div>
        <div class="col-12 col-lg-4 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" maxlength="500" /></div>
    </div></div></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Save</button><a class="btn btn-outline-secondary" asp-action="ChargeTypes">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
