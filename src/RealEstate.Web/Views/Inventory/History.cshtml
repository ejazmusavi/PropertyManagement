@model InventoryHistoryViewModel
@using RealEstate.Domain.Enums
@{ ViewData["Title"] = "Inventory history"; var f = Model.Filter; var h = Model.History;
   var route = new Dictionary<string, string?> { ["projectId"] = f.ProjectId?.ToString(), ["status"] = f.Status?.ToString(), ["search"] = f.Search, ["from"] = f.From?.ToString("yyyy-MM-dd"), ["to"] = f.To?.ToString("yyyy-MM-dd") }; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1 class="h3 mb-0">Inventory history</h1><a class="btn btn-outline-secondary" asp-action="Reports">Reports</a></div>
<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-12 col-md-3"><select name="projectId" class="form-select" aria-label="Project"><option value="">All projects</option>@foreach (var p in Model.Projects) { <option value="@p.Id" selected="@(p.Id == f.ProjectId)">@p.ProjectCode</option> }</select></div>
    <div class="col-6 col-md-2"><select name="status" class="form-select" aria-label="New status"><option value="">Any status</option>@foreach (var s in Enum.GetValues<PropertyStatus>()) { <option value="@s" selected="@(f.Status == s)">@s</option> }</select></div>
    <div class="col-6 col-md-2"><input type="date" name="from" value="@f.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="From" /></div>
    <div class="col-6 col-md-2"><input type="date" name="to" value="@f.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="To" /></div>
    <div class="col-6 col-md-3 d-flex gap-2"><input type="search" name="search" value="@f.Search" class="form-control" placeholder="Code or reason" aria-label="Search" /><button class="btn btn-outline-primary" type="submit">Filter</button></div>
</form>
@if (h.Items.Count == 0) { <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No history found.</p></div> }
else
{
    <div class="card"><div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>When (UTC)</th><th>Property</th><th>From</th><th>To</th><th>Reason</th><th>By</th></tr></thead><tbody>
    @foreach (var x in h.Items) { <tr><td data-label="When">@x.ChangedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td data-label="Property"><a asp-controller="Properties" asp-action="Details" asp-route-id="@x.PropertyId">@x.PropertyCode</a></td><td data-label="From">@(x.FromStatus?.ToString() ?? "-")</td><td data-label="To"><partial name="_StatusBadge" model="x.ToStatus" /></td><td data-label="Reason">@x.Reason</td><td data-label="By">@x.ChangedBy</td></tr> }
    </tbody></table></div></div>
    <partial name="_Pager" model='(h.Page, h.TotalPages, h.TotalCount, "entries", route, "page")' />
}
