@model BuilderViewModel
@using RealEstate.Domain.Enums
@inject RealEstate.Web.Services.UiPermissions Ui
@{ var a = Model.Agreement; var s = a.CurrencySymbol; ViewData["Title"] = "Schedule builder " + a.AgreementNumber; await Ui.LoadAsync();
   var canEdit = a.CanEditCharges && Ui.Has("installments.schedule"); }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div><h1 class="h3 mb-1">Schedule builder – @a.AgreementNumber</h1><div class="text-muted">@a.ProjectCode &middot; @a.Customers &middot; @a.Properties</div></div>
    <div class="d-flex flex-wrap gap-2"><a class="btn btn-primary" asp-action="Preview" asp-route-id="@a.AgreementId">Preview schedule</a><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@a.AgreementId">Agreement installments</a></div>
</div>
@if (!a.CanEditCharges)
{
    <div class="alert alert-info">The schedule has been generated, so charges can no longer be edited here. Use <a asp-controller="AgreementAmendments" asp-action="Create" asp-route-id="@a.AgreementId">an amendment</a> to change it.</div>
}
<partial name="_Reconciliation" model="(Model.Preview, s)" />
@if (canEdit)
{
    <div class="card mb-3"><div class="card-header fw-semibold">Apply a plan</div><div class="card-body">
    @if (Model.Plans.Count == 0) { <p class="text-muted mb-0">No active plans apply to this agreement. <a asp-controller="InstallmentPlans" asp-action="Index">Create and activate a plan</a>, or add charges manually below.</p> }
    else
    {
        <form id="applyForm" asp-action="ApplyPlan" asp-route-id="@a.AgreementId" method="post" class="row g-3 align-items-end">
            <input type="hidden" name="rowVersion" value="@a.RowVersion" />
            <div class="col-12 col-lg-5"><label class="form-label" for="planId">Plan</label><select id="planId" name="planId" class="form-select" required><option value="">- Select -</option>@foreach (var x in Model.Plans) { <option value="@x.Id" selected="@(a.PlanId == x.Id)">@x.Code – @x.Name (@x.PlanType.Label())</option> }</select></div>
            <div class="col-12 col-lg-4"><label class="form-label" for="startDate">Start date</label><input id="startDate" name="startDate" type="date" class="form-control" value="@(a.ScheduleStartDate?.ToString("yyyy-MM-dd") ?? a.BookingDate.ToString("yyyy-MM-dd"))" /></div>
            <div class="col-12 col-lg-3">@if (a.Charges.Count > 0) { <button class="btn btn-primary w-100" type="button" data-bs-toggle="modal" data-bs-target="#applyModal">Apply plan</button> } else { <button class="btn btn-primary w-100" type="submit">Apply plan</button> }</div>
            @if (a.Charges.Count > 0) { <div class="col-12 text-muted small">Applying a plan replaces the charges below.</div> }
        </form>
    }
    </div></div>
}
<div class="card mb-3"><div class="card-header d-flex justify-content-between align-items-center"><span class="fw-semibold">Charges (@a.Charges.Count)</span>
    @if (canEdit) { <a class="btn btn-sm btn-primary" asp-action="AddCharge" asp-route-id="@a.AgreementId">Add charge</a> }</div>
@if (a.Charges.Count == 0) { <div class="card-body text-muted">No charges yet. Apply a plan or add a charge.</div> }
else
{
    <div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>#</th><th>Charge</th><th>Category</th><th class="text-end">Amount</th><th>Schedule</th><th>First due</th><th>Late fee / grace</th><th></th></tr></thead><tbody>
    @foreach (var c in a.Charges)
    {
        <tr><td data-label="#">@c.SortOrder</td><td data-label="Charge">@c.Description</td><td data-label="Category">@c.Category.Label()</td><td data-label="Amount" class="text-end">@c.Amount.ToString("N2")</td>
            <td data-label="Schedule">@c.Frequency.Label()@(c.Frequency == ScheduleFrequency.CustomDates ? $" ({c.CustomEntries.Count} dates)" : c.NumberOfInstallments is { } n ? $" x {n}" : c.InstallmentAmount is { } ia ? $" @ {ia:N2}" : "")</td>
            <td data-label="First due">@c.FirstDueDate.ToString("yyyy-MM-dd")</td><td data-label="Late fee / grace">@(c.LateFeeRuleName ?? "None") / @c.GracePeriodDays d</td>
            <td class="text-end text-nowrap">@if (canEdit)
                {
                    <a class="btn btn-sm btn-outline-primary" asp-action="EditCharge" asp-route-id="@a.AgreementId" asp-route-chargeId="@c.Id">Edit</a>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#removeModal" data-action="@Url.Action("RemoveCharge", new { id = a.AgreementId, chargeId = c.Id })" data-name="@c.Description">Remove</button>
                }</td></tr>
    }</tbody></table></div>
}</div>
@if (canEdit && a.Charges.Count > 0)
{
    <div class="modal fade" id="applyModal" tabindex="-1" aria-labelledby="applyTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="applyTitle">Replace the current charges?</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">Applying the plan replaces all @a.Charges.Count charge(s) below with the plan's charges. The change is audited.</div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" form="applyForm" class="btn btn-primary">Apply plan</button></div></div></div></div>
}
@if (canEdit)
{
    <div class="modal fade" id="removeModal" tabindex="-1" aria-labelledby="removeTitle" aria-hidden="true" data-fill-modal><div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" action="#"><input type="hidden" name="rowVersion" value="@a.RowVersion" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="removeTitle">Remove charge</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">Remove <strong data-fill="name"></strong> from this agreement?</div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Remove</button></div></form></div></div>
}
@section Scripts { <script src="~/js/installments.js" asp-append-version="true"></script> }
