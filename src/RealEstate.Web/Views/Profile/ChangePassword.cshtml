@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<h1 class="h3 mb-3">Change password</h1>
<div class="card"><div class="card-body">
<form asp-action="ChangePassword" method="post" data-loading-form>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12 col-lg-4"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="ConfirmNewPassword" class="form-label"></label><input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span></div>
    </div>
    <p class="text-muted small mt-3 mb-0">At least 12 characters with upper-case, lower-case, a digit and a symbol.</p>
    <div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Change password</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
