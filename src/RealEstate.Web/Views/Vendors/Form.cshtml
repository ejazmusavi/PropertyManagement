@model VendorFormViewModel
@{ var edit = Model.Id is not null; ViewData["Title"] = edit ? "Edit vendor" : "New vendor"; }
<h1 class="h3 mb-3">@ViewData["Title"]@if (edit) { <small class="text-muted"> @Model.Code</small> }</h1>
<form asp-action="@(edit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-loading-form>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="RowVersion" /><input type="hidden" asp-for="Code" />
    <div class="card mb-3"><div class="card-body"><div class="row g-3">
        <div class="col-12 col-lg-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" maxlength="200" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-12 col-lg-6"><label asp-for="ContactPerson" class="form-label"></label><input asp-for="ContactPerson" class="form-control" maxlength="150" /></div>
        <div class="col-12 col-lg-4"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" maxlength="40" /></div>
        <div class="col-12 col-lg-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" maxlength="200" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="col-12 col-lg-4"><label asp-for="TaxNumber" class="form-label"></label><input asp-for="TaxNumber" class="form-control" maxlength="50" /></div>
        <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" maxlength="500" /></div>
        <div class="col-12 col-lg-9"><label asp-for="Notes" class="form-label"></label><input asp-for="Notes" class="form-control" maxlength="1000" /></div>
        <div class="col-12 col-lg-3 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
    </div></div></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Save</button><a class="btn btn-outline-secondary" asp-action="@(edit ? "Details" : "Index")" asp-route-id="@Model.Id">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
