@model VendorListViewModel
@using RealEstate.Domain.Common
@inject RealEstate.Web.Services.UiPermissions Ui
@{ ViewData["Title"] = "Vendors"; await Ui.LoadAsync(); var f = Model.Filter; var p = Model.Vendors;
   var route = new Dictionary<string, string?> { ["search"] = f.Search, ["active"] = f.Active?.ToString().ToLowerInvariant() }; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Vendors</h1>
    <div class="d-flex flex-wrap gap-2">
        @if (Ui.Has(Permissions.VendorsManage)) { <a class="btn btn-primary" asp-action="Create">New vendor</a><a class="btn btn-outline-secondary" asp-controller="VendorInvoices" asp-action="Create">Register invoice</a> }
        <a class="btn btn-outline-secondary" asp-controller="VendorInvoices" asp-action="Index">Vendor invoices</a>
    </div>
</div>
<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-12 col-lg-5"><input type="search" name="search" value="@f.Search" class="form-control" placeholder="Name, code, phone or tax number" aria-label="Search vendors" /></div>
    <div class="col-6 col-lg-3"><select name="active" class="form-select" aria-label="Status"><option value="">All vendors</option><option value="true" selected="@(f.Active == true)">Active</option><option value="false" selected="@(f.Active == false)">Inactive</option></select></div>
    <div class="col-6 col-lg-2"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
</form>
@if (p.Items.Count == 0)
{
    <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No vendors found.</p></div>
}
else
{
    <div class="card"><div class="table-responsive-md"><table class="table table-hover align-middle mb-0 table-stack">
        <thead><tr><th>Vendor</th><th>Contact</th><th class="text-end">Payable</th><th class="text-end">Paid</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var x in p.Items)
        {
            <tr><td data-label="Vendor">@x.Name<div class="small text-muted">@x.Code</div></td><td data-label="Contact">@(x.ContactPerson ?? "-")<div class="small text-muted">@x.Phone</div></td>
                <td data-label="Payable" class="text-end">@x.Payable.ToString("N2")</td><td data-label="Paid" class="text-end">@x.Paid.ToString("N2")</td><td data-label="Status">@(x.IsActive ? "Active" : "Inactive")</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Open</a></td></tr>
        }
        </tbody></table></div></div>
    <partial name="_Pager" model='(p.Page, p.TotalPages, p.TotalCount, "vendors", route, "page")' />
}
