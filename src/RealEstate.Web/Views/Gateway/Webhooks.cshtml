@model WebhookListViewModel
@using RealEstate.Domain.Enums
@{ ViewData["Title"] = "Payment callback log"; var f = Model.Filter; var p = Model.Result;
   var route = new Dictionary<string, string?> { ["status"] = f.Status?.ToString(), ["provider"] = f.Provider }; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Payment callback log</h1><a class="btn btn-outline-secondary" asp-action="Index">Transactions</a></div>
<form method="get" asp-action="Webhooks" class="row g-2 mb-3">
    <div class="col-12 col-md-4"><select name="status" class="form-select" aria-label="Processing status"><option value="">All results</option>@foreach (var s in Enum.GetValues<WebhookProcessingStatus>()) { <option value="@s" selected="@(f.Status == s)">@s</option> }</select></div>
    <div class="col-12 col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
</form>
@if (p.Items.Count == 0) { <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No callbacks received.</p></div> }
else
{
    <div class="card"><div class="table-responsive-md"><table class="table align-middle mb-0 table-stack">
        <thead><tr><th>Received</th><th>Provider</th><th>Event</th><th>Reference</th><th>Signature</th><th>Result</th><th>Message</th></tr></thead><tbody>
        @foreach (var x in p.Items)
        {
            <tr><td data-label="Received">@x.ReceivedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td><td data-label="Provider">@x.Provider</td><td data-label="Event">@(x.EventId ?? "-")</td><td data-label="Reference">@(x.ProviderReference ?? "-")</td>
                <td data-label="Signature"><span class="badge @(x.SignatureValid ? "text-bg-success" : "text-bg-danger")">@(x.SignatureValid ? "Valid" : "Invalid")</span></td>
                <td data-label="Result">@x.ProcessingStatus</td><td data-label="Message">@x.ProcessingMessage</td></tr>
        }
        </tbody></table></div></div>
    <partial name="_Pager" model='(p.Page, p.TotalPages, p.TotalCount, "callbacks", route, "page")' />
}
