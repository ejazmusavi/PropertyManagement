@model CustomerDetailsViewModel
@using RealEstate.Domain.Enums
@inject RealEstate.Web.Services.UiPermissions Ui
@{ var c = Model.Customer; ViewData["Title"] = "Customer documents"; await Ui.LoadAsync(); }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1 class="h3 mb-1">Customer documents</h1><div class="text-muted">@c.CustomerCode – @c.FullName</div></div>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@c.Id">Back to customer</a>
</div>
<div class="card mb-3"><div class="card-header fw-semibold">Documents (CNIC, passport, photos, proof of address, other)</div>
@if (Model.Documents.Count == 0) { <div class="card-body text-muted">No documents uploaded.</div> }
else {
<div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>Title</th><th>Type</th><th>File</th><th class="text-end">Size</th><th>Uploaded</th><th></th></tr></thead><tbody>
@foreach (var d in Model.Documents) { <tr><td data-label="Title">@d.Title</td><td data-label="Type">@d.DocumentType</td><td data-label="File">@d.FileName</td><td data-label="Size" class="text-end">@((d.SizeBytes / 1024.0).ToString("N0")) KB</td><td data-label="Uploaded">@d.UploadedAtUtc.ToString("yyyy-MM-dd") by @d.UploadedBy</td>
    <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="DownloadDocument" asp-route-id="@c.Id" asp-route-documentId="@d.Id">Download</a>
    @if (Ui.Has("customers.documents")) { <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteDocModal" data-doc-id="@d.Id" data-doc-title="@d.Title">Remove</button> }</td></tr> }
</tbody></table></div> }
@if (Ui.Has("customers.documents"))
{
    <div class="card-body border-top"><form asp-action="UploadDocument" asp-route-id="@c.Id" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-12 col-lg-4"><label class="form-label">File</label><input type="file" name="file" class="form-control" required /></div>
        <div class="col-6 col-lg-3"><label class="form-label">Type</label><select name="type" asp-items="Html.GetEnumSelectList<CustomerDocumentType>()" class="form-select"></select></div>
        <div class="col-6 col-lg-4"><label class="form-label">Title</label><input name="title" class="form-control" maxlength="200" /></div>
        <div class="col-12 col-lg-1"><button class="btn btn-primary w-100" type="submit">Upload</button></div></form></div>
}
</div>
<div class="modal fade" id="deleteDocModal" tabindex="-1" aria-labelledby="deleteDocTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" asp-action="DeleteDocument" asp-route-id="@c.Id" method="post"><input type="hidden" name="documentId" id="deleteDocId" />
        <div class="modal-header"><h2 class="modal-title fs-5" id="deleteDocTitle">Remove document</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"><p>Remove <strong id="deleteDocName"></strong>? The file is archived and the removal is audited.</p><label class="form-label">Reason (required)</label><input name="reason" class="form-control" required maxlength="1000" /></div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Remove</button></div></form></div></div>
@section Scripts {
<script>
document.getElementById('deleteDocModal')?.addEventListener('show.bs.modal', function (e) { document.getElementById('deleteDocId').value = e.relatedTarget.dataset.docId; document.getElementById('deleteDocName').textContent = e.relatedTarget.dataset.docTitle; });
</script>
}
