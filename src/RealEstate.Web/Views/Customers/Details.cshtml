@model CustomerDetailsViewModel
@using RealEstate.Domain.Enums
@inject RealEstate.Web.Services.UiPermissions Ui
@{ var c = Model.Customer; ViewData["Title"] = c.CustomerCode; await Ui.LoadAsync(); }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div><h1 class="h3 mb-1">@c.FullName <small class="text-muted fs-6">@c.CustomerCode</small>
        <span class="badge @(c.Status switch { CustomerStatus.Active => "text-bg-success", CustomerStatus.Inactive => "text-bg-secondary", _ => "text-bg-danger" })">@c.Status</span></h1>
        <div class="text-muted">@c.IdentityType @c.IdentityNumber &middot; @c.Mobile @(string.IsNullOrEmpty(c.Email) ? "" : "· " + c.Email)</div></div>
    <div class="d-flex flex-wrap gap-2">
        @if (Ui.Has("bookings.create") && c.Status == CustomerStatus.Active) { <a class="btn btn-primary" asp-controller="Bookings" asp-action="Create">New booking</a> }
        @if (Ui.Has("customers.manage")) { <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Edit</a> }
        <a class="btn btn-outline-secondary" asp-action="Documents" asp-route-id="@c.Id">Documents</a>
        @if (Ui.Has("ledgers.view")) { <a class="btn btn-outline-secondary" asp-controller="Ledgers" asp-action="Customer" asp-route-id="@c.Id">Ledger</a> }
        <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Details</div><div class="card-body"><dl class="row mb-0">
        <dt class="col-sm-4">Primary address</dt><dd class="col-sm-8">@(c.Address ?? "-")</dd>
        <dt class="col-sm-4">Remarks</dt><dd class="col-sm-8">@(c.Remarks ?? "-")</dd>
        <dt class="col-sm-4">Registered</dt><dd class="col-sm-8">@c.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") by @c.CreatedBy</dd>
        @if (c.ModifiedAtUtc is { } m) { <dt class="col-sm-4">Modified</dt><dd class="col-sm-8">@m.ToString("yyyy-MM-dd HH:mm") by @c.ModifiedBy</dd> }
    </dl></div></div></div>
    <div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Addresses and contacts</div><div class="card-body">
        @if (c.Addresses.Count == 0 && c.Contacts.Count == 0) { <span class="text-muted">None recorded.</span> }
        @foreach (var a in c.Addresses) { <div>@a.AddressType: @a.Line1@(string.IsNullOrEmpty(a.City) ? "" : ", " + a.City)@(string.IsNullOrEmpty(a.Country) ? "" : ", " + a.Country) @if (a.IsPrimary) { <span class="badge text-bg-info">Primary</span> }</div> }
        @foreach (var x in c.Contacts) { <div>@x.Name@(string.IsNullOrEmpty(x.Relation) ? "" : " (" + x.Relation + ")"): @x.Phone @x.Email</div> }
    </div></div></div>
</div>
<div class="card mb-3"><div class="card-header fw-semibold">Nominees</div>
@if (c.Nominees.Count == 0) { <div class="card-body text-muted">No nominees.</div> }
else {
<div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>Name</th><th>Relationship</th><th>CNIC</th><th>Mobile</th><th class="text-end">Share</th></tr></thead><tbody>
@foreach (var n in c.Nominees) { <tr><td data-label="Name">@n.FullName</td><td data-label="Relationship">@n.Relationship</td><td data-label="CNIC">@(n.IdentityNumber ?? "-")</td><td data-label="Mobile">@(n.Mobile ?? "-")</td><td data-label="Share" class="text-end">@n.SharePercent.ToString("0.####")%</td></tr> }
</tbody></table></div> }</div>
<div class="card mb-3"><div class="card-header fw-semibold">Properties owned</div>
@if (c.Ownerships.Count == 0) { <div class="card-body text-muted">This customer does not own any property yet.</div> }
else {
<div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>Property</th><th>Project</th><th>Booking</th><th class="text-end">Share</th><th>Status</th><th>Since</th><th>Ended</th></tr></thead><tbody>
@foreach (var o in c.Ownerships) { <tr><td data-label="Property">@if (Ui.Has("inventory.view")) { <a asp-controller="Properties" asp-action="Details" asp-route-id="@o.PropertyId">@o.PropertyCode</a> } else { @o.PropertyCode }</td><td data-label="Project">@o.ProjectCode</td>
    <td data-label="Booking">@if (Ui.Has("bookings.view")) { <a asp-controller="Bookings" asp-action="Details" asp-route-id="@o.BookingId">@o.BookingNumber</a> } else { @o.BookingNumber }</td>
    <td data-label="Share" class="text-end">@o.SharePercent.ToString("0.####")%</td><td data-label="Status"><span class="badge @(o.IsActive ? "text-bg-success" : "text-bg-secondary")">@(o.IsActive ? "Active" : "Closed")</span></td>
    <td data-label="Since">@o.StartedAtUtc.ToString("yyyy-MM-dd")</td><td data-label="Ended">@(o.EndedAtUtc is { } e ? e.ToString("yyyy-MM-dd") + " – " + o.EndReason : "-")</td></tr> }
</tbody></table></div> }</div>
<div class="card mb-3"><div class="card-header fw-semibold">Related customers</div>
@if (c.Relationships.Count == 0) { <div class="card-body text-muted">No related customers.</div> }
else {
<div class="table-responsive-md"><table class="table align-middle mb-0 table-stack"><thead><tr><th>Customer</th><th>Relationship</th><th>Notes</th><th></th></tr></thead><tbody>
@foreach (var r in c.Relationships) { <tr><td data-label="Customer"><a asp-action="Details" asp-route-id="@r.RelatedCustomerId">@r.RelatedCode – @r.RelatedName</a></td><td data-label="Relationship">@r.RelationshipType</td><td data-label="Notes">@(r.Notes ?? "-")</td>
    <td class="text-end">@if (Ui.Has("customers.manage")) { <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#removeRelModal" data-rel-id="@r.Id" data-rel-name="@r.RelatedName">Remove</button> }</td></tr> }
</tbody></table></div> }
@if (Ui.Has("customers.manage"))
{
    <div class="card-body border-top"><form asp-action="AddRelationship" asp-route-id="@c.Id" method="post" class="row g-2 align-items-end">
        <div class="col-12 col-lg-4"><label class="form-label" for="relSearch">Find customer</label><input type="search" id="relSearch" class="form-control" placeholder="Name, code or CNIC" autocomplete="off" /></div>
        <div class="col-12 col-lg-3"><label class="form-label" for="relCustomer">Customer</label><select name="relatedCustomerId" id="relCustomer" class="form-select" required><option value="">- Search first -</option></select></div>
        <div class="col-6 col-lg-2"><label class="form-label">Relationship</label><select name="relationshipType" asp-items="Html.GetEnumSelectList<CustomerRelationshipType>()" class="form-select"></select></div>
        <div class="col-6 col-lg-2"><label class="form-label">Notes</label><input name="notes" class="form-control" maxlength="500" /></div>
        <div class="col-12 col-lg-1"><button class="btn btn-primary w-100" type="submit">Add</button></div></form></div>
}
</div>
<div class="card mb-3"><div class="card-header d-flex justify-content-between"><span class="fw-semibold">Documents</span><a asp-action="Documents" asp-route-id="@c.Id">Manage documents</a></div>
@if (Model.Documents.Count == 0) { <div class="card-body text-muted">No documents uploaded.</div> }
else { <ul class="list-group list-group-flush">@foreach (var d in Model.Documents) { <li class="list-group-item d-flex justify-content-between"><span>@d.Title <span class="text-muted small">(@d.DocumentType)</span></span><a asp-action="DownloadDocument" asp-route-id="@c.Id" asp-route-documentId="@d.Id">Download</a></li> }</ul> }
</div>
<div class="modal fade" id="removeRelModal" tabindex="-1" aria-labelledby="removeRelTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" asp-action="RemoveRelationship" asp-route-id="@c.Id" method="post"><input type="hidden" name="relationshipId" id="relId" />
        <div class="modal-header"><h2 class="modal-title fs-5" id="removeRelTitle">Remove relationship</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"><p>Remove the link to <strong id="relName"></strong>? The removal is audited.</p><label class="form-label">Reason (required)</label><input name="reason" class="form-control" required maxlength="1000" /></div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Remove</button></div></form></div></div>
@section Scripts {
<script>
document.getElementById('removeRelModal')?.addEventListener('show.bs.modal', function (e) { document.getElementById('relId').value = e.relatedTarget.dataset.relId; document.getElementById('relName').textContent = e.relatedTarget.dataset.relName; });
(function () {
  var box = document.getElementById('relSearch'); if (!box) return; var sel = document.getElementById('relCustomer'); var timer;
  box.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () {
      fetch('@Url.Action("CustomerLookup", "Bookings")?activeOnly=false&term=' + encodeURIComponent(box.value), { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : []; }).then(function (rows) {
        sel.innerHTML = ''; rows.filter(function (x) { return x.id !== @c.Id; }).forEach(function (x) { var o = document.createElement('option'); o.value = x.id; o.textContent = x.customerCode + ' – ' + x.fullName; sel.appendChild(o); });
        if (!sel.options.length) { var o = document.createElement('option'); o.value = ''; o.textContent = 'No matches'; sel.appendChild(o); }
      });
    }, 250);
  });
})();
</script>
}
