@model FollowUpFormViewModel
@using RealEstate.Domain.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@{ ViewData["Title"] = "Record follow-up"; var s = Model.CurrencySymbol; }
<h1 class="h3 mb-3">Record follow-up</h1>
<partial name="_RecoveryNav" model='"FollowUps"' />
@if (Model.Agreement is null)
{
    <partial name="_AgreementPicker" model='("RecordFollowUp", Model.Term, Model.Searched, Model.Matches)' />
}
else
{
    var a = Model.Agreement;
    <div class="card mb-3"><div class="card-body"><dl class="row mb-0">
        <dt class="col-sm-3">Agreement</dt><dd class="col-sm-9"><a href="/Ledgers/Agreement/@a.AgreementId">@a.AgreementNumber</a> &middot; booking @a.BookingNumber &middot; project @a.ProjectCode</dd>
        <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@a.CustomerName (@a.CustomerCode)</dd>
        <dt class="col-sm-3">Currently overdue</dt><dd class="col-sm-9">@s @Model.Overdue.ToString("N2")</dd>
    </dl></div></div>
    <form asp-action="RecordFollowUp" method="post" data-loading-form>
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="AgreementId" />
        <div class="card mb-3"><div class="card-body"><div class="row g-3">
            <div class="col-12 col-lg-4"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" type="date" class="form-control" /><span asp-validation-for="FollowUpDate" class="text-danger small"></span></div>
            <div class="col-12 col-lg-4"><label asp-for="Method" class="form-label"></label><select asp-for="Method" class="form-select" asp-items="EnumText.Options<FollowUpMethod>()"></select></div>
            <div class="col-12 col-lg-4"><label asp-for="Outcome" class="form-label"></label><select asp-for="Outcome" id="followUpOutcome" class="form-select" asp-items="EnumText.Options<FollowUpOutcome>()"></select></div>
            <div class="col-12 col-lg-4 promise-field"><label asp-for="PromisedAmount" class="form-label"></label><input asp-for="PromisedAmount" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="PromisedAmount" class="text-danger small"></span></div>
            <div class="col-12 col-lg-4 promise-field"><label asp-for="PromisedDate" class="form-label"></label><input asp-for="PromisedDate" type="date" class="form-control" /><span asp-validation-for="PromisedDate" class="text-danger small"></span></div>
            <div class="col-12 col-lg-4"><label asp-for="NextFollowUpDate" class="form-label"></label><input asp-for="NextFollowUpDate" type="date" class="form-control" /><span asp-validation-for="NextFollowUpDate" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000"></textarea><span asp-validation-for="Notes" class="text-danger small"></span></div>
        </div></div></div>
        <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>Save follow-up</button><a class="btn btn-outline-secondary" asp-action="FollowUps" asp-route-agreementId="@a.AgreementId">Cancel</a></div>
    </form>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var outcome = document.getElementById('followUpOutcome');
            if (!outcome) return;
            var fields = document.querySelectorAll('.promise-field');
            function sync() { var promise = outcome.value === '@((int)FollowUpOutcome.PromiseToPay)'; fields.forEach(function (f) { f.classList.toggle('d-none', !promise); }); }
            outcome.addEventListener('change', sync); sync();
        })();
    </script>
}
