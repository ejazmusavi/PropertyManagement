@model FiscalYearsViewModel
@using RealEstate.Domain.Enums
@using RealEstate.Domain.Common
@inject RealEstate.Web.Services.UiPermissions Ui
@{ ViewData["Title"] = "Financial years"; await Ui.LoadAsync(); var canManage = Ui.Has(Permissions.AccountingPeriodsManage); }
<h1 class="h3 mb-3">Financial years</h1>
<div class="row g-3">
    <div class="@(canManage ? "col-12 col-xl-8" : "col-12")">
        @if (Model.Years.Count == 0) { <div class="empty-state card card-body text-center text-muted">No fiscal years yet. Journals can be posted only into periods of a fiscal year.</div> }
        else {
        <div class="card"><div class="table-responsive-md"><table class="table table-hover align-middle mb-0 table-stack">
            <thead><tr><th>Fiscal year</th><th>From</th><th>To</th><th>Periods (open / closed / locked)</th><th>Status</th><th></th></tr></thead><tbody>
            @foreach (var y in Model.Years)
            {
                <tr><td data-label="Fiscal year">@y.Name</td><td data-label="From">@y.StartDate.ToString("yyyy-MM-dd")</td><td data-label="To">@y.EndDate.ToString("yyyy-MM-dd")</td>
                    <td data-label="Periods">@y.Periods.Count(p => p.Status == AccountingPeriodStatus.Open) / @y.Periods.Count(p => p.Status == AccountingPeriodStatus.Closed) / @y.Periods.Count(p => p.Status == AccountingPeriodStatus.Locked)</td>
                    <td data-label="Status">@y.Status.Label()</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@y.Id">Periods</a></td></tr>
            }
            </tbody></table></div></div> }
    </div>
    @if (canManage)
    {
        <div class="col-12 col-xl-4"><div class="card"><div class="card-header fw-semibold">New fiscal year</div><div class="card-body">
            <form asp-action="Create" method="post" class="row g-2">
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <div class="col-12"><label asp-for="Form.Name" class="form-label">Name</label><input asp-for="Form.Name" class="form-control" /></div>
                <div class="col-6"><label asp-for="Form.StartDate" class="form-label">Start date</label><input asp-for="Form.StartDate" type="date" class="form-control" /></div>
                <div class="col-6"><label asp-for="Form.EndDate" class="form-label">End date</label><input asp-for="Form.EndDate" type="date" class="form-control" /></div>
                <div class="col-12 form-text">Starts on the first and ends on the last day of a month; monthly accounting periods are created automatically. Years cannot overlap.</div>
                <div class="col-12"><button type="submit" class="btn btn-primary">Create fiscal year</button></div>
            </form></div></div></div>
    }
</div>
