@model RefundListViewModel
@using RealEstate.Domain.Enums
@using RealEstate.Domain.Common
@inject RealEstate.Web.Services.UiPermissions Ui
@{ ViewData["Title"] = "Refunds"; await Ui.LoadAsync(); var f = Model.Filter; var p = Model.Refunds;
   var route = new Dictionary<string, string?> { ["search"] = f.Search, ["projectId"] = f.ProjectId?.ToString(), ["status"] = f.Status?.ToString(), ["agreementId"] = f.AgreementId?.ToString() }; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Refunds</h1>
    <div class="d-flex flex-wrap gap-2">
        @if (Ui.Has(Permissions.RefundsRequest)) { <a class="btn btn-primary" asp-action="Create">Request refund</a> }
        @if (Ui.Has(Permissions.RefundsApprove)) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-status="Requested">Awaiting approval</a> }
        @if (Ui.Has(Permissions.RefundsPay)) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-status="Approved">Awaiting payout</a> }
    </div>
</div>
<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-12 col-lg-4"><input type="search" name="search" value="@f.Search" class="form-control" placeholder="Refund, agreement or customer" aria-label="Search refunds" /></div>
    <div class="col-6 col-lg-3"><select name="projectId" class="form-select" aria-label="Project"><option value="">All projects</option>@foreach (var x in Model.Projects) { <option value="@x.Id" selected="@(f.ProjectId == x.Id)">@x.ProjectCode</option> }</select></div>
    <div class="col-6 col-lg-3"><select name="status" class="form-select" aria-label="Status"><option value="">All statuses</option>@foreach (var s in Enum.GetValues<PaymentRefundStatus>()) { <option value="@s" selected="@(f.Status == s)">@s.Label()</option> }</select></div>
    <div class="col-12 col-lg-2"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
</form>
@if (p.Items.Count == 0)
{
    <div class="empty-state card card-body text-center"><p class="mb-0 text-muted">No refunds found.</p></div>
}
else
{
    <div class="card"><div class="table-responsive-md"><table class="table table-hover align-middle mb-0 table-stack">
        <thead><tr><th>Refund</th><th>Agreement</th><th>Customer</th><th class="text-end">Amount</th><th>Requested</th><th>Paid on</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var x in p.Items)
        {
            <tr><td data-label="Refund">@x.RefundNumber<div class="small text-muted">@x.ProjectCode</div></td><td data-label="Agreement">@x.AgreementNumber</td><td data-label="Customer">@x.CustomerName</td>
                <td data-label="Amount" class="text-end">@x.Amount.ToString("N2")</td><td data-label="Requested">@x.RequestedAtUtc.ToString("yyyy-MM-dd") by @x.RequestedBy</td>
                <td data-label="Paid on">@(x.PaidOn?.ToString("yyyy-MM-dd") ?? "-")</td><td data-label="Status">@x.Status.Label()</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Open</a></td></tr>
        }
        </tbody></table></div></div>
    <partial name="_Pager" model='(p.Page, p.TotalPages, p.TotalCount, "refunds", route, "page")' />
}
