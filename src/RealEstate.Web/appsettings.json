{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning", "System": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/web-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Database": { "ServerVersion": "8.4.0", "MigrateOnStartup": false },
  "Jwt": { "Issuer": "RealEstate", "Audience": "RealEstate.Api", "AccessTokenMinutes": 15, "RefreshTokenDays": 14 },
  "FileStorage": { "RootPath": "App_Data/storage" },
  "BackgroundProcessing": { "Enabled": false, "RunServer": true, "WorkerCount": 2, "RunAsUserName": "" },
  "Notifications": { "Email": { "Enabled": false, "Host": "", "Port": 587, "UseSsl": true, "FromAddress": "", "FromName": "" }, "Channels": { "Sms": { "Mode": "Off" }, "WhatsApp": { "Mode": "Off" }, "Push": { "Mode": "Off" } } },
  "Assistant": { "Enabled": false, "BaseUrl": "https://api.openai.com/v1", "ApiKey": "", "ChatModel": "gpt-4o-mini", "VoiceEnabled": true, "TranscriptionModel": "whisper-1", "SpeechModel": "tts-1", "Voice": "alloy", "TimeoutSeconds": 60 },
  "AllowedHosts": "*"
}
